# Shockwave UI theme: a telemetry console. Obsidian void, matte slate panels, square
# controls with crisp 1px borders, electric cyan for what's active, amber for secondary data.
#
# Edit and save while the editor is running: the UI restyles straight away.
# Run the editor from the project folder so it picks up this file (it falls back to a
# copy next to the executable). Make your own by copying this file and passing
# --theme path/to/yours.swtheme, or set EngineConfig::guiTheme in your game.
#
# Colors are sRGB hex, #rrggbb or #rrggbbaa (aa = opacity). Sizes are pixels at 100%
# display scale; HiDPI screens scale them for you. A pair like "12 8" is x then y;
# a single number sets both. Leave a key out to keep the built-in value (shockwave/Gui.h).
# A '#' followed by a space starts a comment.

# The GUI packs colors as 8-bit linear values for the sRGB swapchain, so near-black
# tones snap to a few steps (sRGB 0, 13, 22, 28, 34, 38...). The dark colors below sit
# on those steps so they show exactly as written and keep one cool slate hue.
[palette]
background      = #06080a   # windows: the obsidian void (shows as #000d0d, see below)
panel           = #0d161c   # inner panels: lists, child regions, table rows
surface         = #0d1616   # menu bar, title bars, tab bars, popups
frame           = #0d1c22   # buttons, text fields, sliders, checkboxes
frame_hover     = #16222a
frame_active    = #0d3542
border          = #223d49   # 1px lines around panels and controls
header          = #0d1c26   # collapsing headers, selected rows
header_hover    = #16323d
text            = #d4dee6
text_disabled   = #5c6875

# The accent marks what's active: the focused panel, the current tool, the open tab,
# ticked checkboxes, sliders and telemetry graph lines. Electric cyan.
# Try #3b82f6 for electric blue or see ember.swtheme for burnt orange.
accent          = #00e5ff
accent_hover    = #6cf3ff
accent_active   = #00b4cc
secondary       = #ffb020   # amber: histograms and hovered graph values
selection       = #00e5ff2e   # selected text; the accent at about 18% opacity

scrollbar       = #162632
scrollbar_hover = #263d49

# All custom tool colors are replaceable here, including overlays and errors.
button          = #0d1c22
button_hover    = #16222a
button_active   = #00b4cc
on_accent       = #02090c   # text on accent fills: near-black on cyan
warning         = #ffd23f
error           = #ff3d5a

# Geometry is fixed by the tools design system. Legacy keys are accepted on load,
# but corners stay square and borders stay 1 logical pixel (scaled on HiDPI).
[shape]
window_rounding    = 0
child_rounding     = 0
frame_rounding     = 0
popup_rounding     = 0
tab_rounding       = 0
grab_rounding      = 0
scrollbar_rounding = 0

window_border      = 1
frame_border       = 1
popup_border       = 1
tab_border         = 1
docking_separator  = 1

# Dense: information first.
[spacing]
window_padding     = 6 4
frame_padding      = 6 3
item_spacing       = 4 3
item_inner_spacing = 3 3
cell_padding       = 4 2
indent_spacing     = 12
scrollbar_size     = 8
grab_min_size      = 4

[text]
font_size = 14
font      = fonts/Cousine-Regular.ttf   # monospaced; fonts/Roboto-Medium.ttf is also shipped

# [colors]
# Any single ImGui color by its name overrides everything above, for example:
# PlotLines = #22c55e
