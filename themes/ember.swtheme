# Shockwave UI theme: neutral graphite with a burnt orange accent.
# A partial theme: keys left out keep the built-in (telemetry) values from shockwave/Gui.h.
# Try it with: ./build/bin/editor --theme themes/ember.swtheme

[palette]
background    = #121214
surface       = #19191c
panel         = #161618
frame         = #18181b
frame_hover   = #222226
frame_active  = #27272a
border        = #3f3f46
header        = #1d1d21
header_hover  = #26262b
text          = #ededef
text_disabled = #71717a
scrollbar     = #27272a
scrollbar_hover = #3f3f46
button        = #18181b
button_hover  = #26262b
accent        = #ea580c
accent_hover  = #fb923c
accent_active = #fb923c
selection     = #ea580c38
secondary     = #fbbf24

button_active = #c2410c
on_accent = #121214
warning = #fbbf24
error = #f87171
