+}
+
+// Motion vector flipbook blending (flipbookParameter.y == 2).
+// The motion texture has the same layout as the color flipbook. Red is the motion along U,
+// green along V, and 0.5 means no motion. flipbookParameter.zw is the strength times the
+// size of one cell, in UV. The current frame is pushed forward along its motion and the next
+// frame is pulled back along its own, so a moving shape stays sharp instead of doubling.
+// This replaces dst, which has to be the plain sample of the current frame times vcolor.
+void ApplyFlipbookMotion(inout float4 dst,
+						 const Texture2D t,
+						 const SamplerState s,
+						 const Texture2D motionTex,
+						 const SamplerState motionSampler,
+						 const float4 flipbookParameter,
+						 const float4 vcolor,
+						 const float2 currentUV,
+						 const float2 nextUV,
+						 float flipbookRate,
+						 bool convertFromSRGB)
+{
+	if (flipbookParameter.x > 0 && flipbookParameter.y == 2)
+	{
+		float2 currentMotion = (motionTex.Sample(motionSampler, currentUV).xy * 2.0 - 1.0) * flipbookParameter.zw;
+		float2 nextMotion = (motionTex.Sample(motionSampler, nextUV).xy * 2.0 - 1.0) * flipbookParameter.zw;
+
+		float4 currentColor = t.Sample(s, currentUV - currentMotion * flipbookRate);
+		float4 nextColor = t.Sample(s, nextUV + nextMotion * (1.0 - flipbookRate));
+
+		if (convertFromSRGB)
+		{
+			currentColor = ConvertFromSRGBTexture(currentColor, convertFromSRGB);
+			nextColor = ConvertFromSRGBTexture(nextColor, convertFromSRGB);
+		}
+
+		dst = lerp(currentColor, nextColor, flipbookRate) * vcolor;
+	}
+}
