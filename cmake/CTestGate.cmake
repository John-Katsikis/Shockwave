# Runs a filtered set of tests the way CI does (docs/Testing.md#ci): lists what the filter
# selects first (ctest --show-only=json-v1), refuses a filter that selects nothing or fewer
# tests than expected or misses a test it must include, then runs exactly those.
#
#   cmake -DBUILD=build [-DCONFIG=Release] [-DLABELS=regex] [-DEXCLUDE_LABELS=regex]
#         [-DTESTS=regex] [-DEXCLUDE_TESTS=regex] [-DEXPECT=minimum count]
#         [-DREQUIRE=name;name] [-DREQUIRE_FILE=Tests/RequiredTests.txt -DPLATFORM=linux]
#         [-DREPEAT=until-fail:3] [-DPARALLEL=4] [-DNAME=what] -P cmake/CTestGate.cmake
#
# REQUIRE names tests the filter must select. REQUIRE_FILE lists tests the build must define
# at all (on PLATFORM), whatever the filter: a test that vanished behind a changed condition
# stops the job too.
#
# The summary (what was selected, how many were expected, the result) also goes to
# $GITHUB_STEP_SUMMARY when it's set.
cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED BUILD)
    message(FATAL_ERROR "CTestGate.cmake needs -DBUILD=<build folder>")
endif()
if(NOT DEFINED NAME)
    set(NAME "tests")
endif()
set(filter --test-dir "${BUILD}")
if(DEFINED CONFIG AND NOT CONFIG STREQUAL "")
    list(APPEND filter -C "${CONFIG}")
endif()
if(DEFINED LABELS AND NOT LABELS STREQUAL "")
    list(APPEND filter -L "${LABELS}")
endif()
if(DEFINED EXCLUDE_LABELS AND NOT EXCLUDE_LABELS STREQUAL "")
    list(APPEND filter -LE "${EXCLUDE_LABELS}")
endif()
if(DEFINED TESTS AND NOT TESTS STREQUAL "")
    list(APPEND filter -R "${TESTS}")
endif()
if(DEFINED EXCLUDE_TESTS AND NOT EXCLUDE_TESTS STREQUAL "")
    list(APPEND filter -E "${EXCLUDE_TESTS}")
endif()

execute_process(COMMAND ${CMAKE_CTEST_COMMAND} ${filter} --show-only=json-v1
    RESULT_VARIABLE code OUTPUT_VARIABLE listing ERROR_VARIABLE listing_error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "${NAME}: ctest couldn't list the tests (exit ${code}):\n${listing_error}")
endif()
string(JSON count LENGTH "${listing}" tests)
set(selected "")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON test GET "${listing}" tests ${i} name)
        list(APPEND selected "${test}")
    endforeach()
endif()

# Everything the build defines, for REQUIRE_FILE.
set(defined "")
if(DEFINED REQUIRE_FILE)
    if(NOT DEFINED PLATFORM)
        message(FATAL_ERROR "${NAME}: REQUIRE_FILE needs -DPLATFORM=linux, macos or windows")
    endif()
    set(everything --test-dir "${BUILD}")
    if(DEFINED CONFIG AND NOT CONFIG STREQUAL "")
        list(APPEND everything -C "${CONFIG}")
    endif()
    execute_process(COMMAND ${CMAKE_CTEST_COMMAND} ${everything} --show-only=json-v1
        RESULT_VARIABLE code OUTPUT_VARIABLE all_listing)
    string(JSON all_count LENGTH "${all_listing}" tests)
    if(all_count GREATER 0)
        math(EXPR last "${all_count} - 1")
        foreach(i RANGE ${last})
            string(JSON test GET "${all_listing}" tests ${i} name)
            list(APPEND defined "${test}")
        endforeach()
    endif()
    file(STRINGS "${REQUIRE_FILE}" lines)
    set(required_here "")
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "#.*" "" line "${line}")
        string(STRIP "${line}" line)
        if(line STREQUAL "")
            continue()
        endif()
        string(REGEX REPLACE "[ \t]+" ";" words "${line}")
        list(POP_FRONT words test)
        if(NOT words OR PLATFORM IN_LIST words)
            list(APPEND required_here "${test}")
        endif()
    endforeach()
endif()

string(REPLACE ";" " " filter_shown "${filter}")
set(problems "")
if(count EQUAL 0)
    list(APPEND problems "the filter selects no tests (${filter_shown})")
endif()
if(DEFINED EXPECT AND count LESS EXPECT)
    list(APPEND problems "it selects ${count} tests; at least ${EXPECT} are expected")
endif()
foreach(test IN LISTS REQUIRE)
    if(NOT test IN_LIST selected)
        list(APPEND problems "${test} isn't among them")
    endif()
endforeach()

foreach(test IN LISTS required_here)
    if(NOT test IN_LIST defined)
        list(APPEND problems "${test} is required on ${PLATFORM} (${REQUIRE_FILE}) but this build doesn't define it")
    endif()
endforeach()

set(expected_shown "")
if(DEFINED EXPECT)
    set(expected_shown " (at least ${EXPECT} expected)")
endif()
message(STATUS "${NAME}: ${count} tests selected${expected_shown}")
if(problems)
    list(JOIN problems "\n  " shown)
    set(summary "### ${NAME}: refused\n\n${count} tests selected${expected_shown}:\n  ${shown}\n")
    if(DEFINED ENV{GITHUB_STEP_SUMMARY})
        file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "${summary}\n")
    endif()
    message(FATAL_ERROR "${NAME}:\n  ${shown}")
endif()

set(run ${filter} --output-on-failure --no-tests=error)
if(DEFINED REPEAT AND NOT REPEAT STREQUAL "")
    list(APPEND run --repeat "${REPEAT}")
endif()
if(DEFINED PARALLEL AND NOT PARALLEL STREQUAL "")
    list(APPEND run -j "${PARALLEL}")
endif()
execute_process(COMMAND ${CMAKE_CTEST_COMMAND} ${run} RESULT_VARIABLE code)
if(code EQUAL 0)
    set(result "passed")
else()
    set(result "failed (ctest exit ${code})")
endif()
if(DEFINED ENV{GITHUB_STEP_SUMMARY})
    file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "### ${NAME}: ${result}\n\n${count} tests${expected_shown}\n\n")
endif()
if(NOT code EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${result}")
endif()
message(STATUS "${NAME}: ${count} tests passed")
