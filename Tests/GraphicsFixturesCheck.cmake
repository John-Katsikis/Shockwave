# Renders each graphics fixture scene once (Tests/fixtures/graphics) and checks the result
# isn't empty, then renders the moving scene twice with --fixed-step and requires identical
# pixels. Comparing against the recorded baseline is Tools/capture.py --compare: baselines
# are only meaningful on the driver that recorded them.
file(MAKE_DIRECTORY "${TEMP}")
file(GLOB scenes "${FIXTURE}/Scenes/*.swscene")
foreach(scene ${scenes})
    get_filename_component(name "${scene}" NAME_WE)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics --scene "${scene}"
        --size 320x180 --fixed-step --frames 10 --screenshot "${TEMP}/${name}.png"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${name} didn't render: ${out}\n${err}")
    endif()
    execute_process(COMMAND "${PLAYER}" --image-stats "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE stats)
    string(REGEX MATCH "\"mean_luma\": ([0-9.]+)" _ "${stats}")
    if(NOT result EQUAL 0 OR CMAKE_MATCH_1 LESS 10)
        message(FATAL_ERROR "${name} rendered (nearly) black: ${stats}")
    endif()
endforeach()
foreach(run 1 2)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/motion.swscene" --camera "Orbit camera" --size 320x180 --fixed-step --frames 40
        --screenshot "${TEMP}/motion-${run}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "motion run ${run} failed: ${out}\n${err}")
    endif()
endforeach()
execute_process(COMMAND "${PLAYER}" --image-diff "${TEMP}/motion-1.png" "${TEMP}/motion-2.png" --tolerance 0
    RESULT_VARIABLE result OUTPUT_VARIABLE out)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "--fixed-step frames differ between runs: ${out}")
endif()
execute_process(COMMAND "${PLAYER}" --image-diff "${TEMP}/motion.png" "${TEMP}/motion-1.png" --tolerance 0
    RESULT_VARIABLE result OUTPUT_VARIABLE out)
if(result EQUAL 0)
    message(FATAL_ERROR "frame 10 and frame 40 of the moving scene are identical: nothing moved")
endif()
# --graphics-report: the capabilities, settings and memory report, and that every draw in
# the fixtures carries a stable instance key (temporal effects depend on it).
execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
    --scene "${FIXTURE}/Scenes/motion.swscene" --size 320x180 --graphics-report --json "${TEMP}/report.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "--graphics-report failed: ${out}\n${err}")
endif()
file(READ "${TEMP}/report.json" report)
string(JSON gpu_bytes GET "${report}" memory gpu_bytes)
string(JSON unkeyed GET "${report}" unkeyed_draws)
string(JSON draws GET "${report}" draws)
string(JSON settings LENGTH "${report}" settings)
if(gpu_bytes EQUAL 0 OR draws EQUAL 0 OR settings EQUAL 0)
    message(FATAL_ERROR "--graphics-report is missing memory, draws or settings: ${report}")
endif()
if(NOT unkeyed EQUAL 0)
    message(FATAL_ERROR "${unkeyed} of ${draws} draws have no RenderInstanceKey")
endif()
# FXAA (G01): against a 2x supersampled reference it must bring the image closer, touch
# only edges (flat areas are left bit for bit), and keep the overall brightness.
function(render_thin name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/thin-geometry.swscene" --size 640x360 --fixed-step --frames 10 ${ARGN}
        --screenshot "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "thin-geometry (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
function(image_diff a b out_var)
    execute_process(COMMAND "${PLAYER}" --image-diff "${TEMP}/${a}.png" "${TEMP}/${b}.png" --tolerance 255
        --json "${TEMP}/diff.json" RESULT_VARIABLE result OUTPUT_QUIET)
    file(READ "${TEMP}/diff.json" json)
    set(${out_var} "${json}" PARENT_SCOPE)
endfunction()
render_thin(aa-none --anti-aliasing none)
render_thin(aa-fxaa --anti-aliasing fxaa)
render_thin(aa-default)
render_thin(aa-reference --anti-aliasing none --render-scale 2)
image_diff(aa-none aa-default json)
string(JSON rmse GET "${json}" rmse)
if(NOT rmse EQUAL 0)
    message(FATAL_ERROR "anti_aliasing none differs from the default (rmse ${rmse}): none must be the old path")
endif()
image_diff(aa-reference aa-none json)
string(JSON rmse_none GET "${json}" rmse)
image_diff(aa-reference aa-fxaa json)
string(JSON rmse_fxaa GET "${json}" rmse)
if(NOT rmse_fxaa LESS rmse_none)
    message(FATAL_ERROR "FXAA didn't bring thin-geometry closer to the supersampled image: ${rmse_fxaa} vs ${rmse_none}")
endif()
image_diff(aa-none aa-fxaa json)
string(JSON changed GET "${json}" changed_percent)
string(JSON luma_none GET "${json}" reference mean_luma)
string(JSON luma_fxaa GET "${json}" candidate mean_luma)
if(changed GREATER 10)
    message(FATAL_ERROR "FXAA changed ${changed}% of thin-geometry: it should only touch edges")
endif()
if(luma_fxaa GREATER luma_none)
    set(luma_hi ${luma_fxaa})
    set(luma_lo ${luma_none})
else()
    set(luma_hi ${luma_none})
    set(luma_lo ${luma_fxaa})
endif()
string(REGEX REPLACE "\\..*" "" hi_int "${luma_hi}")
string(REGEX REPLACE "\\..*" "" lo_int "${luma_lo}")
math(EXPR luma_gap "${hi_int} - ${lo_int}")
if(luma_gap GREATER 1)
    message(FATAL_ERROR "FXAA changed the mean brightness: ${luma_none} -> ${luma_fxaa}")
endif()

# Off paths (A00): a feature that's off has no pass in the frame graph and no GPU memory.
execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
    --scene "${FIXTURE}/Scenes/thin-geometry.swscene" --size 320x180 --anti-aliasing none
    --graphics-set bloom_quality=off --graphics-report --json "${TEMP}/off.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "--graphics-report with bloom and anti-aliasing off failed: ${out}\n${err}")
endif()
file(READ "${TEMP}/off.json" report)
string(JSON graph GET "${report}" frame_graph)
string(JSON bloom_bytes GET "${report}" memory categories bloom bytes)
string(JSON aa_bytes GET "${report}" memory categories anti-aliasing bytes)
if(graph MATCHES "bloom" OR graph MATCHES "fxaa" OR NOT bloom_bytes EQUAL 0 OR NOT aa_bytes EQUAL 0)
    message(FATAL_ERROR "bloom/anti-aliasing off still costs passes or memory (bloom ${bloom_bytes}, aa ${aa_bytes}):\n${graph}")
endif()
foreach(tier low medium high)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/thin-geometry.swscene" --size 320x180 --anti-aliasing fxaa
        --graphics-set bloom_quality=${tier} --graphics-report --json "${TEMP}/on.json"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(READ "${TEMP}/on.json" report)
    string(JSON graph GET "${report}" frame_graph)
    string(JSON bloom_bytes GET "${report}" memory categories bloom bytes)
    string(JSON aa_bytes GET "${report}" memory categories anti-aliasing bytes)
    if(NOT result EQUAL 0 OR NOT graph MATCHES "fxaa" OR bloom_bytes EQUAL 0 OR aa_bytes EQUAL 0)
        message(FATAL_ERROR "bloom ${tier} with FXAA is missing a pass or its memory:\n${graph}")
    endif()
endforeach()

# Material bindings (G02): materials.swscene reads its quads through KHR_texture_transform,
# TEXCOORD_1 and sampler modes; materials-expected.swscene has the same quads with all of
# it baked into plain UV0. Albedo (unlit), normal maps (normals) and the lit image with
# its alpha-tested shadows must match. Nearest sampling may round a texel edge a pixel
# either way (about 1.5% of the image, all in the clamp/mirror quad), hence the
# tolerance; one wrong quad changes over 3% of the image by far more.
foreach(view unlit normals lit)
    foreach(scene materials materials-expected)
        execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
            --scene "${FIXTURE}/Scenes/${scene}.swscene" --size 640x360 --fixed-step --frames 10 --view ${view}
            --screenshot "${TEMP}/${scene}-${view}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${scene} (${view}) didn't render: ${out}\n${err}")
        endif()
    endforeach()
    image_diff(materials-expected-${view} materials-${view} json)
    string(JSON rmse GET "${json}" rmse)
    string(JSON changed GET "${json}" changed_percent)
    if(rmse GREATER 1.5 OR changed GREATER 2.5)
        message(FATAL_ERROR "material bindings (${view} view) don't match the baked UVs: rmse ${rmse}, ${changed}% changed")
    endif()
endforeach()

# Material instances (A02): material-instances.swscene draws every materials.glb part
# through a .swmaterial that only names its source material. Resolved through the same
# path as the model's own materials, it must match bit for bit in every view.
foreach(view unlit normals lit)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/material-instances.swscene" --size 640x360 --fixed-step --frames 10 --view ${view}
        --screenshot "${TEMP}/material-instances-${view}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "material-instances (${view}) didn't render: ${out}\n${err}")
    endif()
    image_diff(materials-${view} material-instances-${view} json)
    string(JSON rmse GET "${json}" rmse)
    if(NOT rmse EQUAL 0)
        message(FATAL_ERROR "material instances (${view} view) don't draw exactly like their source: rmse ${rmse}")
    endif()
endforeach()

# Material quality (A02): low leaves out the detail layer, so the detailed cube changes,
# and only a little of the image does.
foreach(quality high low)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/material-layers.swscene" --size 640x360 --fixed-step --frames 10
        --graphics-set material_quality=${quality} --screenshot "${TEMP}/layers-${quality}.png"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "material-layers at material_quality ${quality} didn't render: ${out}\n${err}")
    endif()
endforeach()
image_diff(layers-high layers-low json)
string(JSON rmse GET "${json}" rmse)
string(JSON changed GET "${json}" changed_percent)
if(rmse EQUAL 0 OR changed GREATER 10)
    message(FATAL_ERROR "material_quality low should drop only the detail layer: rmse ${rmse}, ${changed}% changed")
endif()

# Texture quality (A01): low keeps a fraction of each large material texture on the GPU,
# the image changes (softer: the fine floor checker averages to grey up close), and the
# report says so. That the averaging is in linear light is TextureQualityTest's job.
foreach(quality ultra low)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/transparency.swscene" --size 320x180 --graphics-set texture_quality=${quality}
        --graphics-report --json "${TEMP}/quality-${quality}.json"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "--graphics-report at texture_quality ${quality} failed: ${out}\n${err}")
    endif()
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/transparency.swscene" --size 640x360 --fixed-step --frames 10
        --graphics-set texture_quality=${quality} --screenshot "${TEMP}/quality-${quality}.png"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "transparency at texture_quality ${quality} didn't render: ${out}\n${err}")
    endif()
endforeach()
file(READ "${TEMP}/quality-ultra.json" ultra)
file(READ "${TEMP}/quality-low.json" low)
string(JSON ultra_textures GET "${ultra}" memory categories textures bytes)
string(JSON low_textures GET "${low}" memory categories textures bytes)
string(JSON reduced GET "${low}" texture_residency reduced)
string(JSON pending GET "${low}" texture_residency pending)
string(JSON resident GET "${low}" texture_residency resident_bytes)
string(JSON full GET "${low}" texture_residency full_bytes)
string(JSON ultra_reduced GET "${ultra}" texture_residency reduced)
math(EXPR quarter "${full} / 4")
if(reduced EQUAL 0 OR NOT pending EQUAL 0 OR NOT resident LESS quarter OR NOT low_textures LESS ultra_textures
   OR NOT ultra_reduced EQUAL 0)
    message(FATAL_ERROR "texture_quality low didn't shrink material textures: ${reduced} reduced, ${pending} pending, "
                        "${resident} of ${full} bytes; textures ${low_textures} vs ${ultra_textures} at ultra")
endif()
image_diff(quality-ultra quality-low json)
string(JSON rmse GET "${json}" rmse)
if(rmse EQUAL 0)
    message(FATAL_ERROR "texture_quality low rendered exactly like ultra: the smaller images weren't used")
endif()
# Surface prepass and ambient occlusion (G03 + G04), on ambient-occlusion.swscene.
function(render_ao name scene)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --size 640x360 --fixed-step ${ARGN}
        --screenshot "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${scene} (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
function(region_luma image region out_var)
    execute_process(COMMAND "${PLAYER}" --image-stats "${TEMP}/${image}.png" --region ${region}
        RESULT_VARIABLE result OUTPUT_VARIABLE stats)
    string(REGEX MATCH "\"mean_luma\": ([0-9.]+)" _ "${stats}")
    if(NOT result EQUAL 0 OR "${CMAKE_MATCH_1}" STREQUAL "")
        message(FATAL_ERROR "--image-stats ${image} --region ${region} failed: ${stats}")
    endif()
    set(${out_var} ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()
function(expect_same a b what)
    image_diff(${a} ${b} json)
    string(JSON rmse GET "${json}" rmse)
    if(NOT rmse EQUAL 0)
        message(FATAL_ERROR "${what} (rmse ${rmse})")
    endif()
endfunction()
render_ao(ao-view ambient-occlusion --frames 10 --view ao --graphics-set ambient_occlusion=high)
# Sky and open floor are white; the box's contact with the floor is darker; the far wall
# right beside the thin pole 7 m in front of it isn't (no halo).
region_luma(ao-view 0.5,0,0.45,0.08 sky)
region_luma(ao-view 0.6,0.75,0.35,0.2 floor)
region_luma(ao-view 0.5,0.55,0.1,0.05 contact)
region_luma(ao-view 0.79,0.25,0.025,0.12 beside_pole)
if(sky LESS 254.5 OR floor LESS 250 OR NOT contact LESS 248 OR beside_pole LESS 250)
    message(FATAL_ERROR "ambient occlusion view: sky ${sky}, open floor ${floor} (both near 255), "
                        "box contact ${contact} (darker), beside the pole ${beside_pole} (near 255)")
endif()
# A still camera sees still occlusion: the sample rotations are fixed, not random per frame.
render_ao(ao-view-40 ambient-occlusion --frames 40 --view ao --graphics-set ambient_occlusion=high)
expect_same(ao-view ao-view-40 "ambient occlusion flickers: frames 10 and 40 of a still scene differ")
# Render scale changes the resolution it's worked out at, not what it finds.
render_ao(ao-view-half ambient-occlusion --frames 10 --view ao --graphics-set ambient_occlusion=high --render-scale 0.5)
image_diff(ao-view ao-view-half json)
string(JSON rmse GET "${json}" rmse)
if(rmse GREATER 4)
    message(FATAL_ERROR "ambient occlusion at render scale 0.5 differs from 1 by rmse ${rmse}")
endif()
# Off is the old frame exactly, and on with nothing to do is too: ao_intensity 0 runs the
# prepass and the EQUAL-depth shading (alpha test and all) and must change no pixel, and so
# must ambient occlusion on a scene without ambient light (direct light is never occluded).
render_ao(ao-lit-off ambient-occlusion --frames 10 --graphics-set ambient_occlusion=off)
render_ao(ao-lit-high ambient-occlusion --frames 10 --graphics-set ambient_occlusion=high)
render_ao(ao-zero-off ambient-occlusion-zero --frames 10 --graphics-set ambient_occlusion=off)
render_ao(ao-zero-high ambient-occlusion-zero --frames 10 --graphics-set ambient_occlusion=high)
render_ao(ao-direct-off ambient-occlusion-direct --frames 10 --graphics-set ambient_occlusion=off)
render_ao(ao-direct-high ambient-occlusion-direct --frames 10 --graphics-set ambient_occlusion=high)
render_ao(ao-default ambient-occlusion --frames 10)
expect_same(ao-lit-off ao-default "ambient_occlusion off differs from the default: off must be the old path")
expect_same(ao-zero-off ao-zero-high "ao_intensity 0 with ambient occlusion on changed the image")
expect_same(ao-direct-off ao-direct-high "ambient occlusion changed a scene lit only directly")
expect_same(ao-lit-off ao-zero-off "ao_intensity changed the image with ambient occlusion off")
image_diff(ao-lit-off ao-lit-high json)
string(JSON rmse GET "${json}" rmse)
if(rmse EQUAL 0)
    message(FATAL_ERROR "ambient occlusion high didn't change the lit image")
endif()
# The glowing block in the corner is black and emissive: occlusion never dims emission.
# Its inside only: pixels on its silhouette also show the darkened floor and walls.
region_luma(ao-lit-off 0.415,0.455,0.02,0.03 glow_off)
region_luma(ao-lit-high 0.415,0.455,0.02,0.03 glow_high)
if(NOT glow_off EQUAL glow_high)
    message(FATAL_ERROR "ambient occlusion dimmed the emissive block: ${glow_off} -> ${glow_high}")
endif()
# Off has no prepass, no passes and no memory; on has all three.
foreach(ao off medium)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/ambient-occlusion.swscene" --size 320x180 --graphics-set ambient_occlusion=${ao}
        --graphics-report --json "${TEMP}/ao-${ao}.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "--graphics-report with ambient_occlusion ${ao} failed: ${out}\n${err}")
    endif()
    file(READ "${TEMP}/ao-${ao}.json" report)
    string(JSON graph GET "${report}" frame_graph)
    string(JSON surface_bytes GET "${report}" memory categories "surface buffers" bytes)
    string(JSON ao_bytes GET "${report}" memory categories "ambient occlusion" bytes)
    if(ao STREQUAL "off")
        if(graph MATCHES "surface prepass" OR graph MATCHES "ambient occlusion" OR NOT surface_bytes EQUAL 0
           OR NOT ao_bytes EQUAL 0)
            message(FATAL_ERROR "ambient occlusion off still costs passes or memory:\n${graph}")
        endif()
    elseif(NOT graph MATCHES "surface prepass" OR NOT graph MATCHES "ambient occlusion" OR surface_bytes EQUAL 0
           OR ao_bytes EQUAL 0)
        message(FATAL_ERROR "ambient occlusion ${ao} is missing its passes or memory:\n${graph}")
    endif()
endforeach()

# Baked lighting (G05, G06), in a copy of the fixture so the bake never lands in the source
# tree. room-doorway-baked is room-doorway with its room baked: baked_lighting false must
# give room-doorway's exact pixels, and the bake must change them. The red wall's bounce
# reddens the ceiling beside it (the indirect view), the green wall's side doesn't; the
# ball isn't baked and takes its light from the probe volume.
set(BAKED "${TEMP}/baked")
file(COPY "${FIXTURE}/" DESTINATION "${BAKED}")
set(BAKED_SCENE "${BAKED}/Scenes/room-doorway-baked.swscene")
function(bake_room)
    execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --bake-lighting
        --scene "${BAKED_SCENE}" --quality preview --seed 7 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0 OR NOT out MATCHES "receivers 9 in 1 atlases")
        message(FATAL_ERROR "--bake-lighting failed: ${out}\n${err}")
    endif()
endfunction()
function(lighting_state out_var)
    execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --lighting-info
        --scene "${BAKED_SCENE}" --json "${TEMP}/lighting.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "--lighting-info failed: ${out}\n${err}")
    endif()
    file(READ "${TEMP}/lighting.json" json)
    string(JSON state GET "${json}" state)
    set(${out_var} ${state} PARENT_SCOPE)
endfunction()
function(render_baked name)
    execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --no-user-graphics
        --scene "${BAKED_SCENE}" --size 640x360 --fixed-step --frames 10 ${ARGN}
        --screenshot "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "room-doorway-baked (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
# Red minus green, in whole 0..255 steps, over a region.
function(region_red_excess image region out_var)
    execute_process(COMMAND "${PLAYER}" --image-stats "${TEMP}/${image}.png" --region ${region}
        RESULT_VARIABLE result OUTPUT_VARIABLE stats)
    string(REGEX MATCH "\"mean_rgb\": \\[([0-9]+)[.0-9]*, ([0-9]+)" _ "${stats}")
    if(NOT result EQUAL 0 OR "${CMAKE_MATCH_2}" STREQUAL "")
        message(FATAL_ERROR "--image-stats ${image} --region ${region} failed: ${stats}")
    endif()
    math(EXPR excess "${CMAKE_MATCH_1} - ${CMAKE_MATCH_2}")
    set(${out_var} ${excess} PARENT_SCOPE)
endfunction()
lighting_state(state)
if(NOT state STREQUAL "missing")
    message(FATAL_ERROR "room-doorway-baked should start unbaked, --lighting-info says ${state}")
endif()
bake_room()
file(SHA256 "${BAKED}/Content/Lighting/room-doorway-baked/Lightmap_000.ktx2" first_bake)
bake_room()
file(SHA256 "${BAKED}/Content/Lighting/room-doorway-baked/Lightmap_000.ktx2" second_bake)
if(NOT first_bake STREQUAL second_bake)
    message(FATAL_ERROR "the same scene and seed baked different lightmaps")
endif()
lighting_state(state)
if(NOT state STREQUAL "ready")
    message(FATAL_ERROR "after baking, --lighting-info says ${state}")
endif()
execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --check "${BAKED_SCENE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0 OR out MATCHES "warning: baked lighting")
    message(FATAL_ERROR "--check on the baked scene: ${out}\n${err}")
endif()
execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
    --scene "${FIXTURE}/Scenes/room-doorway.swscene" --size 640x360 --fixed-step --frames 10
    --screenshot "${TEMP}/room-unbaked.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "room-doorway didn't render: ${out}\n${err}")
endif()
render_baked(room-baked)
render_baked(room-baked-off --graphics-set baked_lighting=false)
render_baked(room-indirect --view indirect)
render_baked(room-indirect-off --view indirect --graphics-set baked_lighting=false)
expect_same(room-unbaked room-baked-off "baked_lighting false differs from the unbaked scene: off must be the old path")
image_diff(room-unbaked room-baked json)
string(JSON rmse GET "${json}" rmse)
if(rmse LESS 2)
    message(FATAL_ERROR "the bake barely changed the room (rmse ${rmse})")
endif()
region_red_excess(room-indirect 0.86,0.02,0.12,0.1 red_side)
region_red_excess(room-indirect 0.02,0.02,0.12,0.1 green_side)
region_red_excess(room-indirect-off 0.86,0.02,0.12,0.1 red_side_off)
math(EXPR bleed "${red_side} - ${green_side}")
if(bleed LESS 10 OR red_side_off GREATER 10)
    message(FATAL_ERROR "no red bounce on the ceiling beside the red wall: ${red_side} vs ${green_side} on the "
                        "green side, ${red_side_off} unbaked")
endif()
region_luma(room-indirect 0.33,0.55,0.08,0.12 ball_baked)
region_luma(room-indirect-off 0.33,0.55,0.08,0.12 ball_off)
if(ball_baked STREQUAL ball_off)
    message(FATAL_ERROR "the ball didn't take its light from the probe volume")
endif()
# Move the box: its lightmap no longer fits, so it draws with the environment and the bake
# is out of date, but everything else keeps its light. Nothing is rebaked or rewritten.
file(READ "${BAKED_SCENE}" scene_text)
string(REPLACE "position -1.6 0.5 -5.5" "position -1.6 0.5 -4.5" scene_text "${scene_text}")
file(WRITE "${BAKED_SCENE}" "${scene_text}")
lighting_state(state)
if(NOT state STREQUAL "stale")
    message(FATAL_ERROR "after moving the box, --lighting-info says ${state}")
endif()
render_baked(room-moved)
image_diff(room-unbaked room-moved json)
string(JSON rmse GET "${json}" rmse)
if(rmse LESS 2)
    message(FATAL_ERROR "moving one receiver dropped the whole bake (rmse ${rmse} from unbaked)")
endif()

# Reflection probes (G07), in the same copy. reflection-rooms has two rooms with a probe
# and a mirror ball each; the west room is red with a green floor and a blue back wall.
# Before capturing, the balls reflect the sky; reflection_probes false must give exactly
# that image after capturing too. The capture must be repeatable, its cube faces must
# point the right way, and the west ball must reflect its red walls.
set(ROOMS_SCENE "${BAKED}/Scenes/reflection-rooms.swscene")
function(render_rooms name)
    execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --no-user-graphics
        --scene "${ROOMS_SCENE}" --size 640x360 --fixed-step --frames 10 ${ARGN}
        --screenshot "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "reflection-rooms (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
function(capture_rooms)
    execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --capture-reflections
        --scene "${ROOMS_SCENE}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0 OR NOT out MATCHES "manifest Lighting/reflection-rooms.swreflection")
        message(FATAL_ERROR "--capture-reflections failed: ${out}\n${err}")
    endif()
endfunction()
function(reflection_state out_var)
    execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --lighting-info
        --scene "${ROOMS_SCENE}" --json "${TEMP}/lighting.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "--lighting-info failed: ${out}\n${err}")
    endif()
    file(READ "${TEMP}/lighting.json" json)
    string(JSON state GET "${json}" reflections state)
    set(${out_var} ${state} PARENT_SCOPE)
endfunction()
reflection_state(state)
if(NOT state STREQUAL "missing")
    message(FATAL_ERROR "reflection-rooms should start uncaptured, --lighting-info says ${state}")
endif()
render_rooms(rooms-uncaptured)
capture_rooms()
set(WEST_CUBE "${BAKED}/Content/Lighting/reflection-rooms_reflections/Probe_5e0a1c3b7d2f4a6b8c9d0e1f2a3b4c5d.ktx2")
file(SHA256 "${WEST_CUBE}" first_capture)
capture_rooms()
file(SHA256 "${WEST_CUBE}" second_capture)
if(NOT first_capture STREQUAL second_capture)
    message(FATAL_ERROR "capturing the same scene twice gave different cubes")
endif()
reflection_state(state)
if(NOT state STREQUAL "ready")
    message(FATAL_ERROR "after capturing, --lighting-info says ${state}")
endif()
execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --check "${ROOMS_SCENE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0 OR out MATCHES "warning: reflection probes")
    message(FATAL_ERROR "--check on the captured scene: ${out}\n${err}")
endif()
# Face orientation, from the west cube's face means (+X, -X, +Y, -Y, +Z, -Z): the green
# floor below, the lamp-lit ceiling the brightest, the red wall to -X, the blue one to -Z.
execute_process(COMMAND "${PLAYER}" --project "${BAKED}/Graphics.swproject" --lighting-export "${WEST_CUBE}"
    --output "${TEMP}/west-cube.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "--lighting-export of a reflection cube failed: ${out}\n${err}")
endif()
file(READ "${TEMP}/west-cube.json" cube_json)
foreach(face 0 1 2 3 4 5)
    foreach(channel 0 1 2)
        string(JSON value GET "${cube_json}" face_means ${face} ${channel})
        # In thousandths, for integer math: "0.2230..." is 223; tiny values ("1e-05") are 0.
        if(value MATCHES "^([0-9]+)\\.?([0-9]*)$")
            set(whole "${CMAKE_MATCH_1}")
            set(frac "${CMAKE_MATCH_2}000")
            string(SUBSTRING "${frac}" 0 3 frac)
            math(EXPR milli "${whole} * 1000 + 1${frac} - 1000")
        else()
            set(milli 0)
        endif()
        set(face${face}_${channel} ${milli})
    endforeach()
endforeach()
math(EXPR ceiling "${face2_0} + ${face2_1} + ${face2_2}")
foreach(face 0 1 3 4 5)
    math(EXPR other "${face${face}_0} + ${face${face}_1} + ${face${face}_2}")
    if(NOT ceiling GREATER other)
        message(FATAL_ERROR "the west cube's +Y face isn't the brightest (the ceiling lamp): face ${face} is ${other}, +Y ${ceiling}")
    endif()
endforeach()
if(NOT face3_1 GREATER face3_0 OR NOT face3_1 GREATER face3_2)
    message(FATAL_ERROR "the west cube's -Y face isn't green (the floor): ${face3_0} ${face3_1} ${face3_2}")
endif()
math(EXPR red_west "${face1_0} - ${face1_1}")
math(EXPR red_east "${face0_0} - ${face0_1}")
math(EXPR blue_back "${face5_2} - ${face5_0}")
math(EXPR blue_front "${face4_2} - ${face4_0}")
if(NOT red_west GREATER red_east OR NOT blue_back GREATER blue_front)
    message(FATAL_ERROR "the west cube's sides point the wrong way: red ${red_west} (-X) vs ${red_east} (+X), "
                        "blue ${blue_back} (-Z) vs ${blue_front} (+Z)")
endif()
render_rooms(rooms-on)
render_rooms(rooms-off --graphics-set reflection_probes=false)
render_rooms(rooms-view --view reflections)
render_rooms(rooms-east --camera East)
expect_same(rooms-uncaptured rooms-off "reflection_probes false differs from the uncaptured scene: off must be the old path")
image_diff(rooms-uncaptured rooms-on json)
string(JSON rmse GET "${json}" rmse)
if(rmse LESS 2)
    message(FATAL_ERROR "the captured probes barely changed the image (rmse ${rmse})")
endif()
region_red_excess(rooms-on 0.40,0.42,0.15,0.12 ball_on)
region_red_excess(rooms-off 0.40,0.42,0.15,0.12 ball_off)
region_red_excess(rooms-east 0.46,0.42,0.12,0.1 ball_east)
if(ball_on LESS 20 OR ball_off GREATER 0 OR ball_east GREATER 10)
    message(FATAL_ERROR "the west ball should reflect its red room (red excess ${ball_on}, ${ball_off} off) and "
                        "the east ball its blue one (${ball_east})")
endif()
# Moving a probe makes it stale; it's left out (the global environment) until captured again.
file(READ "${ROOMS_SCENE}" scene_text)
string(REPLACE "position -4 1.5 0" "position -4 1.4 0" scene_text "${scene_text}")
file(WRITE "${ROOMS_SCENE}" "${scene_text}")
reflection_state(state)
if(NOT state STREQUAL "stale")
    message(FATAL_ERROR "after moving the west probe, --lighting-info says ${state}")
endif()
render_rooms(rooms-moved)
region_red_excess(rooms-moved 0.40,0.42,0.15,0.12 ball_moved)
if(ball_moved GREATER 0)
    message(FATAL_ERROR "the moved probe is still drawn with its old capture (red excess ${ball_moved})")
endif()
# Decals (G08, A03) on decal-wall: a blue poster with a partly transparent yellow stripe
# over it (sort order 1), a sign stuck to the swinging door whose box also covers the wall
# beside it but lands only on the door's receiver layer, and grime on the floor in a box
# the camera is inside. decals_quality off must be exactly the scene without its decals,
# with no decal pass and no surface buffers (ambient occlusion is off too).
set(DECAL_SCENE "${FIXTURE}/Scenes/decal-wall.swscene")
file(READ "${DECAL_SCENE}" scene_text)
string(REPLACE "\n  Decal\n" "\n  Decal\n    enabled 0\n" scene_text "${scene_text}")
file(WRITE "${TEMP}/decal-wall-disabled.swscene" "${scene_text}")
function(render_decals name scene)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${scene}" --size 640x360 --fixed-step --frames 30 ${ARGN}
        --screenshot "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "decal-wall (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
function(region_rgb image region out_r out_g out_b)
    execute_process(COMMAND "${PLAYER}" --image-stats "${TEMP}/${image}.png" --region ${region}
        RESULT_VARIABLE result OUTPUT_VARIABLE stats)
    string(REGEX MATCH "\"mean_rgb\": \\[([0-9]+)[.0-9]*, ([0-9]+)[.0-9]*, ([0-9]+)" _ "${stats}")
    if(NOT result EQUAL 0 OR "${CMAKE_MATCH_3}" STREQUAL "")
        message(FATAL_ERROR "--image-stats ${image} --region ${region} failed: ${stats}")
    endif()
    set(${out_r} ${CMAKE_MATCH_1} PARENT_SCOPE)
    set(${out_g} ${CMAKE_MATCH_2} PARENT_SCOPE)
    set(${out_b} ${CMAKE_MATCH_3} PARENT_SCOPE)
endfunction()
render_decals(decals-on "${DECAL_SCENE}")
render_decals(decals-off "${DECAL_SCENE}" --graphics-set decals_quality=off)
render_decals(decals-none "${TEMP}/decal-wall-disabled.swscene")
render_decals(decals-low "${DECAL_SCENE}" --graphics-set decals_quality=low)
render_decals(decals-view "${DECAL_SCENE}" --view decals)
expect_same(decals-none decals-off "decals_quality off differs from the scene without decals: off must be the old path")
expect_same(decals-on decals-low "five decals are within every budget: low must draw the same as high")
image_diff(decals-off decals-on json)
string(JSON rmse GET "${json}" rmse)
if(rmse LESS 2)
    message(FATAL_ERROR "the decals barely changed decal-wall (rmse ${rmse})")
endif()
region_rgb(decals-on 0.31,0.33,0.03,0.05 r g b)
if(NOT b GREATER r OR NOT b GREATER g)
    message(FATAL_ERROR "the poster isn't blue: ${r} ${g} ${b}")
endif()
region_rgb(decals-on 0.36,0.42,0.04,0.04 r g b)
if(NOT r GREATER b)
    message(FATAL_ERROR "where the stripe overlaps the poster it isn't on top (sort order): ${r} ${g} ${b}")
endif()
region_red_excess(decals-on 0.58,0.42,0.06,0.12 sign)
region_red_excess(decals-off 0.58,0.42,0.06,0.12 sign_off)
region_red_excess(decals-on 0.49,0.42,0.06,0.08 beside)
region_red_excess(decals-off 0.49,0.42,0.06,0.08 beside_off)
math(EXPR sign_gain "${sign} - ${sign_off}")
math(EXPR beside_gain "${beside} - ${beside_off}")
if(sign_gain LESS 40 OR beside_gain GREATER 2)
    message(FATAL_ERROR "the door's sign must land on the door (red gain ${sign_gain}) and not on the wall inside "
                        "its box beside it (${beside_gain}): receiver layers")
endif()
region_luma(decals-on 0.3,0.85,0.4,0.1 floor_on)
region_luma(decals-off 0.3,0.85,0.4,0.1 floor_off)
if(floor_on STREQUAL floor_off)
    message(FATAL_ERROR "the floor grime is missing: the camera is inside its box, which must still draw it")
endif()
region_rgb(decals-view 0.3,0.85,0.4,0.1 r g b)
if(r LESS 100 OR g GREATER 40)
    message(FATAL_ERROR "--view decals doesn't show the grime's coverage on the floor: ${r} ${g} ${b}")
endif()
execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
    --scene "${DECAL_SCENE}" --size 320x180 --graphics-set decals_quality=off --graphics-report --json "${TEMP}/decals.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(READ "${TEMP}/decals.json" report)
string(JSON graph GET "${report}" frame_graph)
string(JSON surface_bytes GET "${report}" memory categories "surface buffers" bytes)
if(NOT result EQUAL 0 OR graph MATCHES "decals" OR graph MATCHES "surface prepass" OR NOT surface_bytes EQUAL 0)
    message(FATAL_ERROR "decals off still costs a pass or memory (surface buffers ${surface_bytes}):\n${graph}")
endif()
execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --check "${DECAL_SCENE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "--check on decal-wall: ${out}\n${err}")
endif()
file(READ "${DECAL_SCENE}" scene_text)
string(REPLACE "    size 1.2 1.2 0.4" "    size 1.2 0 0.4" scene_text "${scene_text}")
file(WRITE "${TEMP}/decal-wall-flat.swscene" "${scene_text}")
execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --check "${TEMP}/decal-wall-flat.swscene"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(result EQUAL 0 OR NOT out MATCHES "Poster': Decal size must be above zero")
    message(FATAL_ERROR "--check let a zero-height decal through: ${out}\n${err}")
endif()
file(REMOVE_RECURSE "${TEMP}")
