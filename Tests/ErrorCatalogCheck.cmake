# The error catalog (S16, docs/ErrorCatalog.md): every code in section 24 of the shipping
# plan maps to an engine code that exists, checked by a test this build defines and CI
# requires.
#   -DSOURCE=<repo> -DCTEST=<ctest> -DBUILD=<build dir>
cmake_minimum_required(VERSION 3.20)   # IN_LIST, and lists that keep empty items
foreach(var SOURCE CTEST BUILD)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "ErrorCatalogCheck.cmake needs -D${var}=...")
    endif()
endforeach()

# Section 24's codes: the first column of its table.
file(STRINGS "${SOURCE}/docs/ShippingImplementation.md" plan)
set(in24 OFF)
set(planned "")
foreach(line IN LISTS plan)
    if(line MATCHES "^## 24\\.")
        set(in24 ON)
    elseif(line MATCHES "^## ")
        set(in24 OFF)
    elseif(in24 AND line MATCHES "^\\| `")
        string(REGEX MATCH "^\\|([^|]*)\\|" first "${line}")
        string(REGEX MATCHALL "`[A-Za-z]+`" codes "${CMAKE_MATCH_1}")
        foreach(code IN LISTS codes)
            string(REPLACE "`" "" code "${code}")
            list(APPEND planned "${code}")
        endforeach()
    endif()
endforeach()
list(LENGTH planned planned_count)
if(planned_count LESS 15)
    message(FATAL_ERROR "found only ${planned_count} codes in section 24 of docs/ShippingImplementation.md: ${planned}")
endif()

# The tests this build defines, and the ones CI requires.
execute_process(COMMAND "${CTEST}" --test-dir "${BUILD}" -N OUTPUT_VARIABLE listing RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "ctest -N failed: ${listing}")
endif()
string(REGEX MATCHALL "Test +#[0-9]+: [A-Za-z0-9_:.-]+" defined "${listing}")
list(TRANSFORM defined REPLACE "Test +#[0-9]+: " "")
file(STRINGS "${SOURCE}/Tests/RequiredTests.txt" required_lines REGEX "^[a-z]")
set(required "")
foreach(line IN LISTS required_lines)
    string(REGEX MATCH "^[^ ]+" name "${line}")
    list(APPEND required "${name}")
endforeach()

# The catalog's rows.
file(STRINGS "${SOURCE}/docs/ErrorCatalog.md" catalog)
set(covered "")
set(problems "")
set(rows 0)
foreach(line IN LISTS catalog)
    if(NOT line MATCHES "^\\| `[A-Za-z]+` \\|")
        continue()
    endif()
    if(NOT line MATCHES "^\\| `([A-Za-z]+)` \\| `([^`]+)` \\| ([^ |]+) \\| `([a-z0-9_]+)` \\| ([^ |]+) \\| [^|]+ \\|$")
        string(APPEND problems "\n  a row that isn't | `Code` | `engine` | source | `test` | checked in | what happens |: ${line}")
        continue()
    endif()
    set(code "${CMAKE_MATCH_1}")
    set(engine "${CMAKE_MATCH_2}")
    set(source "${CMAKE_MATCH_3}")
    set(test "${CMAKE_MATCH_4}")
    set(checked "${CMAKE_MATCH_5}")
    math(EXPR rows "${rows} + 1")
    list(APPEND covered "${code}")
    if(NOT code IN_LIST planned)
        string(APPEND problems "\n  ${code} isn't a code in section 24")
    endif()
    foreach(file "${source}" "${checked}")
        if(NOT EXISTS "${SOURCE}/${file}")
            string(APPEND problems "\n  ${code}: ${file} doesn't exist")
            continue()
        endif()
        file(READ "${SOURCE}/${file}" text)
        string(FIND "${text}" "${engine}" at)
        if(at EQUAL -1)
            string(APPEND problems "\n  ${code}: \"${engine}\" isn't in ${file}")
        endif()
    endforeach()
    if(NOT test IN_LIST defined)
        string(APPEND problems "\n  ${code}: the test ${test} isn't defined in this build")
    endif()
    if(NOT test IN_LIST required)
        string(APPEND problems "\n  ${code}: the test ${test} isn't in Tests/RequiredTests.txt")
    endif()
endforeach()
foreach(code IN LISTS planned)
    if(NOT code IN_LIST covered)
        string(APPEND problems "\n  section 24's ${code} has no row in docs/ErrorCatalog.md")
    endif()
endforeach()
if(problems)
    message(FATAL_ERROR "docs/ErrorCatalog.md:${problems}")
endif()
list(REMOVE_DUPLICATES covered)
list(LENGTH covered covered_count)
message(STATUS "error catalog: ${covered_count} codes in ${rows} rows, each defined and tested")
