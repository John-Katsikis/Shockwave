if(EXISTS "${TEMP}")
    message(FATAL_ERROR "Test destination must not already exist: ${TEMP}")
endif()
execute_process(COMMAND "${PLAYER}" --new-project "${TEMP}" --name "CLI Starter" --module cli_starter
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Project creation failed: ${out}\n${err}")
endif()
file(READ "${TEMP}/CLIStarter.swproject" manifest)
file(READ "${TEMP}/Source/Game.cpp" source)
if(NOT manifest MATCHES "cli_starter" OR NOT source MATCHES "cli_starter" OR source MATCHES "@GAME_MODULE@")
    message(FATAL_ERROR "Starter has inconsistent module ownership")
endif()
file(WRITE "${TEMP}/keep.txt" "user content")
execute_process(COMMAND "${PLAYER}" --new-project "${TEMP}" --name Replacement
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 1 OR NOT EXISTS "${TEMP}/keep.txt")
    message(FATAL_ERROR "Occupied destination was not safely rejected: ${out}\n${err}")
endif()
file(REMOVE_RECURSE "${TEMP}")
