# The player's command line, recorded (E2): every case in Tests/fixtures/cli/cases.txt
# runs the player and must give the exit code, stdout and stderr recorded beside it in
# Tests/fixtures/cli/expected. It pins today's flags, messages and exit codes, so moving
# the parser around can't change any of them.
#   -DPLAYER=<player> -DSOURCE=<repo> -DTEMP=<scratch folder> [-DRECORD=ON] [-DONLY=<id>]
# RECORD=ON writes the expected files instead of comparing: only for an intended change.
cmake_minimum_required(VERSION 3.20)
foreach(var PLAYER SOURCE TEMP)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "PlayerCliCheck.cmake needs -D${var}=...")
    endif()
endforeach()
set(fixtures "${SOURCE}/Tests/fixtures/cli")
set(expected "${fixtures}/expected")
file(REMOVE_RECURSE "${TEMP}")
file(MAKE_DIRECTORY "${TEMP}")
if(RECORD)
    file(MAKE_DIRECTORY "${expected}")
endif()

# What changes from machine to machine: the folders, the engine's log lines (thread
# counts, timings), a display server's complaints and the build configuration
# (--release-info's "build Release"). A long output is kept as its hash.
function(normalise text casetemp out)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(REPLACE "${casetemp}" "<TEMP>" text "${text}")
    string(REPLACE "${SOURCE}" "<SOURCE>" text "${text}")
    string(REGEX REPLACE "(^|\n)Log[A-Za-z]+: [^\n]*" "" text "${text}")
    string(REGEX REPLACE "(^|\n)error: XDG_RUNTIME_DIR[^\n]*" "" text "${text}")
    string(REGEX REPLACE "(^|\n)build (Debug|Release|RelWithDebInfo|MinSizeRel)?(\n|$)" "\\1build <CONFIG>\\3"
                         text "${text}")
    string(REGEX REPLACE "^\n+" "" text "${text}")
    string(LENGTH "${text}" length)
    if(length GREATER 16000)
        string(SHA256 hash "${text}")
        set(text "sha256 ${hash} (${length} characters)\n")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

file(STRINGS "${fixtures}/cases.txt" lines)
set(failures "")
set(count 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^#" OR NOT line MATCHES "^([A-Za-z0-9_+.-]+): (.*)$")
        continue()
    endif()
    set(id "${CMAKE_MATCH_1}")
    set(args "${CMAKE_MATCH_2}")
    if(DEFINED ONLY AND NOT id STREQUAL ONLY)
        continue()
    endif()
    math(EXPR count "${count} + 1")
    set(casetemp "${TEMP}/${id}")
    file(MAKE_DIRECTORY "${casetemp}/home")
    string(REPLACE "{SOURCE}" "${SOURCE}" args "${args}")
    string(REPLACE "{TEMP}" "${casetemp}" args "${args}")
    separate_arguments(args UNIX_COMMAND "${args}")
    # A fresh home for each run: no settings, saves or logs from another.
    set(ENV{HOME} "${casetemp}/home")
    set(ENV{XDG_DATA_HOME} "${casetemp}/home/.local/share")
    set(ENV{XDG_CONFIG_HOME} "${casetemp}/home/.config")
    set(ENV{APPDATA} "${casetemp}/home")
    set(ENV{LOCALAPPDATA} "${casetemp}/home")
    set(ENV{SDL_VIDEO_DRIVER} "offscreen")
    set(ENV{SDL_AUDIO_DRIVER} "dummy")
    execute_process(COMMAND "${PLAYER}" ${args} WORKING_DIRECTORY "${casetemp}"
                    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
    normalise("${out}" "${casetemp}" out)
    normalise("${err}" "${casetemp}" err)
    if(RECORD)
        file(WRITE "${expected}/${id}.code" "${code}\n")
        file(WRITE "${expected}/${id}.out" "${out}")
        file(WRITE "${expected}/${id}.err" "${err}")
        continue()
    endif()
    if(NOT EXISTS "${expected}/${id}.code")
        string(APPEND failures "\n  ${id}: nothing recorded (run with -DRECORD=ON)")
        continue()
    endif()
    file(READ "${expected}/${id}.code" wantCode)
    file(READ "${expected}/${id}.out" wantOut)
    file(READ "${expected}/${id}.err" wantErr)
    string(STRIP "${wantCode}" wantCode)
    if(NOT code STREQUAL wantCode)
        string(APPEND failures "\n  ${id}: exit ${code}, recorded ${wantCode}")
    endif()
    if(NOT out STREQUAL wantOut)
        string(APPEND failures "\n  ${id}: stdout differs:\n---- got\n${out}---- recorded\n${wantOut}----")
    endif()
    if(NOT err STREQUAL wantErr)
        string(APPEND failures "\n  ${id}: stderr differs:\n---- got\n${err}---- recorded\n${wantErr}----")
    endif()
endforeach()
if(count EQUAL 0)
    message(FATAL_ERROR "no cases ran from ${fixtures}/cases.txt")
endif()
if(failures)
    message(FATAL_ERROR "player command line:${failures}")
endif()
if(RECORD)
    message(STATUS "player command line: recorded ${count} cases in ${expected}")
else()
    message(STATUS "player command line: ${count} cases as recorded")
endif()
