# Colour grading, exposure and fog (A05, A06) on the GPU, with the graphics fixtures:
#   - each setting off (fog_quality off, color_grading false, auto_exposure false) renders
#     exactly what the scene without its PostProcessVolume renders, with no pass and no
#     memory for it;
#   - fog fades the far floor much more than the near one; analytic and froxel fog agree
#     away from lights, and only the froxel volume shows the lamp glowing in the air; the
#     fog view is lighter near the camera than far away;
#   - grading warms the colour chart; a neutral profile (D65, an identity LUT) changes
#     next to nothing;
#   - auto exposure brings a room lit 32 times brighter than another to nearly the same
#     brightness;
#   - the report's postprocess block and memory follow each setting.
cmake_policy(SET CMP0054 NEW)   # quoted strings in if() are never variables
file(MAKE_DIRECTORY "${TEMP}")
function(render scene name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --fixed-step --size 640x360 --frames 5 ${ARGN}
        --screenshot "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${scene} (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
function(report scene name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --size 320x180 ${ARGN} --graphics-report --json "${TEMP}/${name}.json"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "--graphics-report (${scene} ${ARGN}) failed: ${out}\n${err}")
    endif()
    file(READ "${TEMP}/${name}.json" json)
    set(json "${json}" PARENT_SCOPE)
endfunction()
# RMSE between two screenshots over a region.
function(rmse a b region out)
    execute_process(COMMAND "${PLAYER}" --image-diff "${TEMP}/${a}.png" "${TEMP}/${b}.png" --tolerance 255
        --region "${region}" --json "${TEMP}/diff.json" OUTPUT_QUIET)
    file(READ "${TEMP}/diff.json" diff)
    string(JSON value GET "${diff}" rmse)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
# Mean colour over a region, in whole levels.
function(mean image region out)
    execute_process(COMMAND "${PLAYER}" --image-stats "${TEMP}/${image}.png" --region "${region}"
        --json "${TEMP}/stats.json" OUTPUT_QUIET)
    file(READ "${TEMP}/stats.json" stats)
    string(JSON r GET "${stats}" mean_rgb 0)
    string(JSON g GET "${stats}" mean_rgb 1)
    string(JSON b GET "${stats}" mean_rgb 2)
    foreach(c r g b)   # whole levels: math() has no floats
        string(REGEX REPLACE "\\..*" "" ${c} "${${c}}")
    endforeach()
    set(${out} "${r};${g};${b}" PARENT_SCOPE)
endfunction()
# a < b * factor, for decimal numbers (math() has no floats): compared in thousandths.
function(less_than a b factor_permille out)
    foreach(v a b)
        string(REGEX MATCH "^[0-9]+" whole "${${v}}")
        string(REGEX MATCH "\\.([0-9]?[0-9]?[0-9]?)" frac "${${v}}")
        set(frac "${CMAKE_MATCH_1}000")
        string(SUBSTRING "${frac}" 0 3 frac)
        math(EXPR ${v}_m "${whole} * 1000 + 1${frac} - 1000")
    endforeach()
    math(EXPR limit "${b_m} * ${factor_permille} / 1000")
    if(a_m LESS limit)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(mean_luma image region out)
    mean(${image} "${region}" rgb)
    list(GET rgb 0 r)
    list(GET rgb 1 g)
    list(GET rgb 2 b)
    math(EXPR luma "(${r} * 2126 + ${g} * 7152 + ${b} * 722) / 10000")
    set(${out} ${luma} PARENT_SCOPE)
endfunction()
function(identical a b what)
    rmse(${a} ${b} "0,0,1,1" value)
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "${what}: RMSE ${value} from the scene without a volume")
    endif()
endfunction()

# ---- Fog ----
render(postprocess-fog-none fog-none)
render(postprocess-fog fog-off --graphics-set fog_quality=off)
identical(fog-off fog-none "fog_quality off still changes the picture")
render(postprocess-fog fog-medium --graphics-set fog_quality=medium)
render(postprocess-fog fog-analytic --graphics-set fog_quality=analytic)
set(far "0.05,0.5,0.15,0.03")   # the floor 100 m and more away
set(near "0.05,0.9,0.15,0.08")   # the floor a few metres away
rmse(fog-medium fog-none "${far}" far_change)
rmse(fog-medium fog-none "${near}" near_change)
message(STATUS "fog: far floor ${far_change}, near floor ${near_change} RMSE from none")
less_than("${near_change}" "${far_change}" 600 ok)
if(far_change LESS 30 OR NOT ok)
    message(FATAL_ERROR "fog doesn't thicken with distance: far ${far_change}, near ${near_change}")
endif()
rmse(fog-medium fog-analytic "${far}" agree)
message(STATUS "froxel and analytic fog differ by ${agree} on the far floor")
if(agree GREATER 4)
    message(FATAL_ERROR "the froxel volume and analytic fog disagree away from lights: RMSE ${agree}")
endif()
# Around the orange lamp, in the air: the volume scatters its light, analytic fog can't.
mean(fog-medium "0.45,0.36,0.1,0.1" lamp_volume)
mean(fog-analytic "0.45,0.36,0.1,0.1" lamp_analytic)
list(GET lamp_volume 0 vr)
list(GET lamp_volume 2 vb)
list(GET lamp_analytic 0 ar)
list(GET lamp_analytic 2 ab)
math(EXPR warmer "(${vr} - ${vb}) - (${ar} - ${ab})")
message(STATUS "lamp: froxels ${lamp_volume}, analytic ${lamp_analytic}")
if(warmer LESS 6)
    message(FATAL_ERROR "the lamp doesn't glow in the froxel fog: ${lamp_volume} vs analytic ${lamp_analytic}")
endif()
render(postprocess-fog fog-view --view fog)
mean_luma(fog-view "${near}" view_near)
mean_luma(fog-view "${far}" view_far)
math(EXPR clearer "${view_near} - ${view_far}")
if(clearer LESS 60)
    message(FATAL_ERROR "the fog view isn't clearer near the camera: near ${view_near}, far ${view_far}")
endif()

# ---- Colour grading ----
render(postprocess-chart chart)
render(postprocess-grade grade-off --graphics-set color_grading=false)
identical(grade-off chart "color_grading false still grades")
render(postprocess-grade grade)
render(postprocess-neutral neutral)
rmse(neutral chart "0,0,1,1" neutral_change)
message(STATUS "neutral profile: RMSE ${neutral_change} from none")
less_than("${neutral_change}" "1" 1000 ok)
if(NOT ok)
    message(FATAL_ERROR "a D65 white point and an identity LUT change the picture: RMSE ${neutral_change}")
endif()
mean(grade "0.3,0.1,0.4,0.3" graded)
mean(chart "0.3,0.1,0.4,0.3" plain)
list(GET graded 0 gr)
list(GET graded 2 gb)
list(GET plain 0 pr)
list(GET plain 2 pb)
math(EXPR warmer "(${gr} - ${gb}) - (${pr} - ${pb})")
message(STATUS "grade: ${graded} from ${plain}")
if(warmer LESS 15)
    message(FATAL_ERROR "the warm grade doesn't warm the chart: ${graded} from ${plain}")
endif()

# ---- Auto exposure ----
render(postprocess-dark-manual dark-manual)
render(postprocess-dark dark-off --graphics-set auto_exposure=false)
identical(dark-off dark-manual "auto_exposure false still meters")
render(postprocess-bright-manual bright-manual)
render(postprocess-dark dark-auto)
render(postprocess-bright bright-auto)
mean_luma(dark-manual "0,0,1,1" dm)
mean_luma(bright-manual "0,0,1,1" bm)
mean_luma(dark-auto "0,0,1,1" da)
mean_luma(bright-auto "0,0,1,1" ba)
math(EXPR manual_gap "${bm} - ${dm}")
math(EXPR auto_gap "${ba} - ${da}")
if(auto_gap LESS 0)
    math(EXPR auto_gap "-${auto_gap}")
endif()
message(STATUS "auto exposure: manual ${dm} vs ${bm}, metered ${da} vs ${ba}")
math(EXPR limit "${manual_gap} / 5")
if(manual_gap LESS 80 OR NOT auto_gap LESS limit)
    message(FATAL_ERROR "auto exposure doesn't even out a dark and a bright room: manual ${dm} vs ${bm}, "
                        "metered ${da} vs ${ba}")
endif()

# ---- Reports: each setting off costs nothing ----
report(postprocess-fog fog-medium --graphics-set fog_quality=medium)
string(JSON graph GET "${json}" frame_graph)
string(JSON quality GET "${json}" postprocess fog_quality)
string(JSON bytes GET "${json}" memory categories fog bytes)
if(NOT graph MATCHES "fog volume" OR NOT quality STREQUAL "medium" OR bytes EQUAL 0)
    message(FATAL_ERROR "fog_quality medium made no froxel volume (${quality}, ${bytes} bytes):\n${graph}")
endif()
foreach(setting analytic off)
    report(postprocess-fog fog-${setting} --graphics-set fog_quality=${setting})
    string(JSON graph GET "${json}" frame_graph)
    string(JSON quality GET "${json}" postprocess fog_quality)
    string(JSON bytes GET "${json}" memory categories fog bytes)
    if(graph MATCHES "fog volume" OR NOT quality STREQUAL "${setting}" OR NOT bytes EQUAL 0)
        message(FATAL_ERROR "fog_quality ${setting} still has a froxel volume (${quality}, ${bytes} bytes)")
    endif()
endforeach()
report(postprocess-fog-none fog-none --graphics-set fog_quality=high)
string(JSON quality GET "${json}" postprocess fog_quality)
string(JSON reason GET "${json}" postprocess fog_reason)
if(NOT quality STREQUAL "off" OR NOT reason MATCHES "no fog")
    message(FATAL_ERROR "a scene without fog drew some (${quality}: ${reason})")
endif()
report(postprocess-grade grade)
string(JSON luts GET "${json}" postprocess luts)
string(JSON balance GET "${json}" postprocess white_balance)
if(NOT luts EQUAL 1 OR NOT balance)
    message(FATAL_ERROR "the grade profile applied ${luts} LUTs, white balance ${balance}")
endif()
report(postprocess-grade grade-off --graphics-set color_grading=false)
string(JSON luts GET "${json}" postprocess luts)
string(JSON balance GET "${json}" postprocess white_balance)
if(NOT luts EQUAL 0 OR balance)
    message(FATAL_ERROR "color_grading false still applied ${luts} LUTs, white balance ${balance}")
endif()
report(postprocess-dark dark-auto)
string(JSON graph GET "${json}" frame_graph)
string(JSON share GET "${json}" postprocess auto_share)
string(JSON bytes GET "${json}" memory categories exposure bytes)
if(NOT graph MATCHES "exposure histogram" OR share LESS 1 OR bytes EQUAL 0)
    message(FATAL_ERROR "auto exposure didn't meter (share ${share}, ${bytes} bytes):\n${graph}")
endif()
report(postprocess-dark dark-off --graphics-set auto_exposure=false)
string(JSON graph GET "${json}" frame_graph)
string(JSON bytes GET "${json}" memory categories exposure bytes)
if(graph MATCHES "exposure" OR NOT bytes EQUAL 0)
    message(FATAL_ERROR "auto_exposure false still meters or keeps memory (${bytes} bytes):\n${graph}")
endif()
