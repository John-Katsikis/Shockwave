# Exercise the real CLI, not only the validator called by it. Xvfb is installed in CI.
file(MAKE_DIRECTORY "${TEMP}")
set(scene "${TEMP}/audio.swscene")
set(header "shockwave_scene 2\nentity \"Camera\"\n  Transform\n  Camera\n    primary 1\nend\nentity \"Sound\"\n  AudioSource\n    spatial 0\n")
function(check_audio clip volume near far expected message)
    file(WRITE "${scene}" "${header}    clip \"${clip}\"\n    volume ${volume}\n    min_distance ${near}\n    max_distance ${far}\nend\n")
    execute_process(COMMAND "${XVFB}" -a "${PLAYER}" --check "${PROJECT}" "${scene}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "Expected exit ${expected}, got ${result}: ${output}\n${errors}")
    endif()
    if(NOT output MATCHES "${message}")
        message(FATAL_ERROR "Missing '${message}' in: ${output}\n${errors}")
    endif()
endfunction()
check_audio("Audio/pulse.wav" 0.5 1 30 0 "0 problems")
check_audio("Audio/missing.wav" 0.5 1 30 1 "AudioSource clip is missing")
check_audio("Audio/pulse.wav" 1.5 1 30 1 "AudioSource volume must be")
check_audio("Audio/pulse.wav" 0.5 10 2 1 "AudioSource max distance must be")
