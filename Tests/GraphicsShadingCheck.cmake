# Character and specialized shading (A07-A09) on the GPU, with the graphics fixtures:
#   - clearcoat 0 renders exactly plain standard, and clearcoat false exactly the uncoated
#     scene; a coat changes only its own sphere;
#   - solid glass bends the scene behind it (unlike thin glass), shows the box behind it and
#     leaves the wall away from it alone; the transmission view marks on-screen refraction;
#   - skin_quality off renders exactly skin without diffusion; diffusion changes the sphere,
#     not the sky, and moves light rather than making it;
#   - hair_quality high changes the highlight on the cards;
#   - each setting off has no pass and no memory, and scenes without these materials never do.
cmake_policy(SET CMP0054 NEW)   # quoted strings in if() are never variables
file(MAKE_DIRECTORY "${TEMP}")
function(render scene name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --fixed-step --size 640x360 --frames 5 ${ARGN}
        --screenshot "${TEMP}/${name}.png" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${scene} (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
function(report scene name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --size 320x180 ${ARGN} --graphics-report --json "${TEMP}/${name}.json"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "--graphics-report (${scene} ${ARGN}) failed: ${out}\n${err}")
    endif()
    file(READ "${TEMP}/${name}.json" json)
    set(json "${json}" PARENT_SCOPE)
endfunction()
# RMSE between two screenshots over a region.
function(rmse a b region out)
    execute_process(COMMAND "${PLAYER}" --image-diff "${TEMP}/${a}.png" "${TEMP}/${b}.png" --tolerance 255
        --region "${region}" --json "${TEMP}/diff.json" OUTPUT_QUIET)
    file(READ "${TEMP}/diff.json" diff)
    string(JSON value GET "${diff}" rmse)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
# Mean colour over a region, in whole levels.
function(mean image region out)
    execute_process(COMMAND "${PLAYER}" --image-stats "${TEMP}/${image}.png" --region "${region}"
        --json "${TEMP}/stats.json" OUTPUT_QUIET)
    file(READ "${TEMP}/stats.json" stats)
    string(JSON r GET "${stats}" mean_rgb 0)
    string(JSON g GET "${stats}" mean_rgb 1)
    string(JSON b GET "${stats}" mean_rgb 2)
    foreach(c r g b)   # whole levels: math() has no floats
        string(REGEX REPLACE "\\..*" "" ${c} "${${c}}")
    endforeach()
    set(${out} "${r};${g};${b}" PARENT_SCOPE)
endfunction()
# a < b * factor, for decimal numbers (math() has no floats): compared in thousandths.
function(less_than a b factor_permille out)
    foreach(v a b)
        string(REGEX MATCH "^[0-9]+" whole "${${v}}")
        string(REGEX MATCH "\\.([0-9]?[0-9]?[0-9]?)" frac "${${v}}")
        set(frac "${CMAKE_MATCH_1}000")
        string(SUBSTRING "${frac}" 0 3 frac)
        math(EXPR ${v}_m "${whole} * 1000 + 1${frac} - 1000")
    endforeach()
    math(EXPR limit "${b_m} * ${factor_permille} / 1000")
    if(a_m LESS limit)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(mean_luma image region out)
    mean(${image} "${region}" rgb)
    list(GET rgb 0 r)
    list(GET rgb 1 g)
    list(GET rgb 2 b)
    math(EXPR luma "(${r} * 2126 + ${g} * 7152 + ${b} * 722) / 10000")
    set(${out} ${luma} PARENT_SCOPE)
endfunction()
function(identical a b what)
    rmse(${a} ${b} "0,0,1,1" value)
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "${what}: RMSE ${value} from the scene without a volume")
    endif()
endfunction()

# ---- Clearcoat (A07) ----
render(shading-coat-plain coat-plain)
render(shading-coat-zero coat-zero)
identical(coat-zero coat-plain "clearcoat 0 isn't plain standard")
render(shading-coat coat-off --graphics-set clearcoat=false)
identical(coat-off coat-plain "clearcoat false still draws the coat")
render(shading-coat coat)
set(middle "0.4,0.3,0.2,0.35")   # the coated sphere
rmse(coat coat-plain "${middle}" coat_change)
rmse(coat coat-plain "0,0,0.3,1" coat_elsewhere)
message(STATUS "clearcoat: ${coat_change} on the coated sphere, ${coat_elsewhere} on its plain neighbour")
if(coat_change LESS 1 OR NOT coat_elsewhere EQUAL 0)
    message(FATAL_ERROR "the clearcoat changes ${coat_change} on its sphere and ${coat_elsewhere} elsewhere")
endif()

# ---- Transmission (A08) ----
set(solid "0.43,0.4,0.14,0.25")   # the solid block, the blue box behind it
render(shading-glass glass-low --graphics-set transmission_quality=low)
render(shading-glass glass-medium --graphics-set transmission_quality=medium)
render(shading-glass glass-high --graphics-set transmission_quality=high)
render(shading-glass glass-off --graphics-set transmission_quality=off)
render(shading-glass-none glass-none)
rmse(glass-medium glass-low "${solid}" bends)
rmse(glass-medium glass-none "0.8,0.1,0.15,0.2" untouched)
message(STATUS "transmission: solid glass bends ${bends}; the wall away from glass changes ${untouched}")
if(bends LESS 1)
    message(FATAL_ERROR "solid glass on medium doesn't bend the scene behind it (RMSE ${bends} from thin)")
endif()
if(NOT untouched EQUAL 0)
    message(FATAL_ERROR "glass changes the wall where there's no glass: RMSE ${untouched}")
endif()
# The blue box shows through the solid block, bluer than the wall either side of it.
mean(glass-medium "0.48,0.45,0.04,0.1" through)
list(GET through 0 tr)
list(GET through 2 tb)
if(NOT tb GREATER tr)
    message(FATAL_ERROR "the box behind the solid glass doesn't show through: ${through}")
endif()
render(shading-glass glass-view --view transmission)
mean(glass-view "${solid}" view)
list(GET view 1 vg)
if(vg LESS 60)
    message(FATAL_ERROR "the transmission view doesn't show the solid block refracting on screen: ${view}")
endif()

# ---- Skin (A09) ----
render(shading-skin-flat skin-flat)
render(shading-skin skin-off --graphics-set skin_quality=off)
identical(skin-off skin-flat "skin_quality off isn't skin without diffusion")
render(shading-skin skin-low --graphics-set skin_quality=low)
render(shading-skin skin-high --graphics-set skin_quality=high)
set(right "0.52,0.25,0.2,0.4")   # the right sphere, its terminator
rmse(skin-high skin-flat "${right}" diffused)
rmse(skin-high skin-flat "0,0,1,0.12" sky)
message(STATUS "skin: diffusion changes the sphere by ${diffused}, the sky by ${sky}")
if(diffused LESS 1 OR NOT sky EQUAL 0)
    message(FATAL_ERROR "skin diffusion changes the sphere ${diffused}, the sky ${sky}")
endif()
# Diffusion moves light, it doesn't make it: the sphere's mean stays within a few levels.
mean_luma(skin-high "${right}" lit_high)
mean_luma(skin-flat "${right}" lit_flat)
math(EXPR gain "${lit_high} - ${lit_flat}")
if(gain GREATER 6 OR gain LESS -6)
    message(FATAL_ERROR "skin diffusion changed the sphere's brightness: ${lit_flat} -> ${lit_high}")
endif()

# ---- Hair (A09) ----
render(shading-hair hair-low --graphics-set hair_quality=low)
render(shading-hair hair-high --graphics-set hair_quality=high)
rmse(hair-high hair-low "0.3,0.15,0.4,0.5" stretched)
message(STATUS "hair: the anisotropic highlight changes the cards by ${stretched}")
if(stretched LESS 1)
    message(FATAL_ERROR "hair_quality high doesn't change the hair highlight (RMSE ${stretched})")
endif()

# ---- Reports: each setting off costs nothing ----
report(shading-glass glass-medium --graphics-set transmission_quality=medium)
string(JSON graph GET "${json}" frame_graph)
string(JSON bytes GET "${json}" memory categories transmission bytes)
string(JSON draws GET "${json}" shading transmission_draws)
if(NOT graph MATCHES "transmission background copy" OR bytes EQUAL 0 OR NOT draws EQUAL 3)
    message(FATAL_ERROR "transmission medium: ${draws} draws, ${bytes} bytes:\n${graph}")
endif()
report(shading-glass glass-off --graphics-set transmission_quality=off)
string(JSON graph GET "${json}" frame_graph)
string(JSON bytes GET "${json}" memory categories transmission bytes)
string(JSON simplified GET "${json}" shading simplified_glass_draws)
if(graph MATCHES "transmission" OR NOT bytes EQUAL 0 OR NOT simplified EQUAL 3)
    message(FATAL_ERROR "transmission_quality off still has a pass or memory (${bytes} bytes, ${simplified} simplified):\n${graph}")
endif()
report(shading-skin skin-high --graphics-set skin_quality=high)
string(JSON graph GET "${json}" frame_graph)
string(JSON bytes GET "${json}" memory categories skin bytes)
if(NOT graph MATCHES "skin blur" OR bytes EQUAL 0)
    message(FATAL_ERROR "skin_quality high made no skin pass (${bytes} bytes):\n${graph}")
endif()
report(shading-skin skin-off --graphics-set skin_quality=off)
string(JSON graph GET "${json}" frame_graph)
string(JSON bytes GET "${json}" memory categories skin bytes)
if(graph MATCHES "skin" OR NOT bytes EQUAL 0)
    message(FATAL_ERROR "skin_quality off still has a skin pass or memory (${bytes} bytes):\n${graph}")
endif()
# Scenes without these materials: no split scene pass, no memory, whatever the settings.
report(shading-coat-plain plain --graphics-set transmission_quality=high --graphics-set skin_quality=high)
string(JSON graph GET "${json}" frame_graph)
string(JSON tbytes GET "${json}" memory categories transmission bytes)
string(JSON sbytes GET "${json}" memory categories skin bytes)
if(graph MATCHES "see-through|skin|transmission" OR NOT tbytes EQUAL 0 OR NOT sbytes EQUAL 0)
    message(FATAL_ERROR "a scene without glass or skin still pays for them:\n${graph}")
endif()
report(shading-hair hair-high --graphics-set hair_quality=high)
string(JSON anisotropic GET "${json}" shading anisotropic_hair)
report(shading-hair hair-low --graphics-set hair_quality=low)
string(JSON round GET "${json}" shading anisotropic_hair)
if(NOT anisotropic OR round)
    message(FATAL_ERROR "hair_quality doesn't switch the anisotropic highlight (high ${anisotropic}, low ${round})")
endif()
