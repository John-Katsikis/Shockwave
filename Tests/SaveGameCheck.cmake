# The save game command line, end to end: --save, --saves, --check and --load on the
# sample project, with the null renderer so no GPU is needed. Xvfb is installed in CI.
set(slot "ctest-save-check")
get_filename_component(root "${PROJECT}" DIRECTORY)
set(file "${root}/Saved/SaveGames/${slot}.swsave")
function(run expected message)
    execute_process(COMMAND "${XVFB}" -a "${PLAYER}" "${PROJECT}" --renderer null ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL expected)
        file(REMOVE "${file}" "${file}.bak")
        message(FATAL_ERROR "player ${ARGN}: expected exit ${expected}, got ${result}: ${output}\n${errors}")
    endif()
    if(NOT "${output}${errors}" MATCHES "${message}")
        file(REMOVE "${file}" "${file}.bak")
        message(FATAL_ERROR "player ${ARGN}: missing '${message}' in: ${output}\n${errors}")
    endif()
endfunction()
run(0 "Wrote Saved/SaveGames/${slot}.swsave" --save ${slot} --frames 10)
run(0 "${slot} " --saves)
run(0 "ok Saved/SaveGames/${slot}.swsave" --check "${file}")
run(0 "started from save" --load ${slot} --frames 5)
# S06: the envelope, a migrated copy (never over the original), and the JSON list.
set(migrated "${root}/Saved/SaveGames/${slot}-migrated.swsave")
set(json "${root}/Saved/${slot}.json")
file(REMOVE "${migrated}" "${json}")
run(0 "format 2, schema 1, revision 1, checksum ok.*level startup.*loadable" --save-info "${file}")
run(2 "never writes over" --save-migrate "${file}" --output "${file}")
run(0 "Wrote .*-migrated.swsave \\(format 2 to 2" --save-migrate "${file}" --output "${migrated}")
run(0 "loadable" --save-info "${migrated}")
run(0 "Wrote" --saves --json "${json}")
file(READ "${json}" listed)
if(NOT listed MATCHES "\"slot\": \"${slot}\", [^\n]*\"loadable\": true[^\n]*\"level\": \"startup\"")
    file(REMOVE "${file}" "${migrated}" "${json}")
    message(FATAL_ERROR "--saves --json: ${slot} isn't listed as loadable in level startup:\n${listed}")
endif()
file(REMOVE "${migrated}" "${json}")
# An edited file fails its checksum: --check and --load say so.
file(READ "${file}" text)
string(REPLACE "entity_ids 0 " "entity_ids 0 0 " text "${text}")
file(WRITE "${file}" "${text}")
run(1 "Corrupt: .*checksum doesn't match" --check "${file}")
run(1 "checksum doesn't match" --load ${slot} --frames 5)
# Without its checksum line it's a hand-edited save: the broken line is reported.
string(REGEX REPLACE "checksum [0-9a-f]+\n" "" text "${text}")
file(WRITE "${file}" "${text}")
run(1 "entity_ids lists" --check "${file}")
run(1 "entity_ids lists" --load ${slot} --frames 5)
file(REMOVE "${file}" "${file}.bak")
