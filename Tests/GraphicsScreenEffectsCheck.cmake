# Screen effects (V1-V4) on the GPU, with the graphics fixtures. For each effect:
#   - on changes the picture where it should and leaves the rest alone;
#   - off renders exactly what the scene renders without the setting (RMSE 0);
#   - two --fixed-step runs with it on render the same pixels;
#   - the report shows its pass and memory when on, neither when off, and a reason when it
#     can't run (contact shadows without sun shadows, motion blur without TAA).
cmake_policy(SET CMP0054 NEW)   # quoted strings in if() are never variables
file(MAKE_DIRECTORY "${TEMP}")
function(render scene name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --fixed-step --size 320x180 ${ARGN}
        --screenshot "${TEMP}/${name}.png"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "[exit ${result}] ${scene} (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
# The diff's JSON for a region ("x,y,w,h" in 0..1).
function(diff a b region out_var)
    execute_process(COMMAND "${PLAYER}" --image-diff "${TEMP}/${a}.png" "${TEMP}/${b}.png" --tolerance 255
        --region ${region} --json "${TEMP}/diff.json" RESULT_VARIABLE result OUTPUT_QUIET)
    file(READ "${TEMP}/diff.json" json)
    set(${out_var} "${json}" PARENT_SCOPE)
endfunction()
function(require_same a b what)
    diff(${a} ${b} "0,0,1,1" json)
    string(JSON rmse GET "${json}" rmse)
    if(NOT rmse EQUAL 0)
        message(FATAL_ERROR "${what}: ${a} and ${b} differ (RMSE ${rmse})")
    endif()
endfunction()
function(region_mean name region out_var)
    execute_process(COMMAND "${PLAYER}" --image-stats "${TEMP}/${name}.png" --region ${region}
        --json "${TEMP}/stats.json" RESULT_VARIABLE result OUTPUT_QUIET)
    file(READ "${TEMP}/stats.json" json)
    string(JSON r GET "${json}" mean_rgb 0)
    string(JSON g GET "${json}" mean_rgb 1)
    string(JSON b GET "${json}" mean_rgb 2)
    set(${out_var} "${r};${g};${b}" PARENT_SCOPE)
endfunction()
# The report: its frame graph, one memory category's bytes, and one setting's row.
function(report scene name category setting)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --fixed-step --size 320x180 ${ARGN} --graphics-report
        --json "${TEMP}/${name}.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "[exit ${result}] --graphics-report ${scene} (${ARGN}) failed: ${out}\n${err}")
    endif()
    file(READ "${TEMP}/${name}.json" json)
    string(JSON graph GET "${json}" frame_graph)
    string(JSON bytes GET "${json}" memory categories "${category}" bytes)
    string(JSON count LENGTH "${json}" settings)
    math(EXPR last "${count} - 1")
    set(effective "")
    set(reason "")
    foreach(i RANGE ${last})
        string(JSON row GET "${json}" settings ${i} name)
        if(row STREQUAL "${setting}")
            string(JSON effective GET "${json}" settings ${i} effective)
            string(JSON reason GET "${json}" settings ${i} reason)
        endif()
    endforeach()
    set(graph "${graph}" PARENT_SCOPE)
    set(bytes "${bytes}" PARENT_SCOPE)
    set(effective "${effective}" PARENT_SCOPE)
    set(reason "${reason}" PARENT_SCOPE)
endfunction()

# ---- V4 contact shadows ----
render(contact-shadows contact-plain)
render(contact-shadows contact-off --graphics-set contact_shadows=off)
render(contact-shadows contact-on --graphics-set contact_shadows=on)
render(contact-shadows contact-on-2 --graphics-set contact_shadows=on)
require_same(contact-plain contact-off "contact_shadows off")
require_same(contact-on contact-on-2 "contact shadows with --fixed-step")
diff(contact-off contact-on "0,0,1,1" json)
string(JSON changed GET "${json}" changed_percent)
string(JSON luma_off GET "${json}" reference mean_luma)
string(JSON luma_on GET "${json}" candidate mean_luma)
if(changed LESS_EQUAL 0 OR changed GREATER 5 OR luma_on GREATER luma_off)
    message(FATAL_ERROR "contact shadows should darken a few small areas: ${changed}% changed, "
                        "luma ${luma_off} -> ${luma_on}")
endif()
report(contact-shadows contact-report "contact shadows" contact_shadows --graphics-set contact_shadows=on)
if(NOT graph MATCHES "contact shadows" OR bytes EQUAL 0 OR NOT effective STREQUAL "on")
    message(FATAL_ERROR "contact shadows on: no pass or memory (${bytes} bytes, ${effective}):\n${graph}")
endif()
report(contact-shadows contact-report-off "contact shadows" contact_shadows --graphics-set contact_shadows=off)
if(graph MATCHES "contact shadows" OR NOT bytes EQUAL 0)
    message(FATAL_ERROR "contact shadows off still costs a pass or memory (${bytes} bytes):\n${graph}")
endif()
# Without sun shadows there's nothing to trace towards: off, with the reason.
render(contact-shadows contact-noshadow-off --shadows off)
render(contact-shadows contact-noshadow-on --shadows off --graphics-set contact_shadows=on)
require_same(contact-noshadow-off contact-noshadow-on "contact shadows without sun shadows")
report(contact-shadows contact-report-noshadow "contact shadows" contact_shadows --shadows off
       --graphics-set contact_shadows=on)
if(graph MATCHES "contact shadows" OR NOT effective STREQUAL "off" OR reason STREQUAL "")
    message(FATAL_ERROR "contact shadows without sun shadows should fall back with a reason: '${effective}' "
                        "'${reason}'")
endif()

# ---- V1 screen-space reflections ----
render(ssr-floor ssr-plain)
render(ssr-floor ssr-off --graphics-set reflections_quality=off)
render(ssr-floor ssr-high --graphics-set reflections_quality=high)
render(ssr-floor ssr-high-30 --graphics-set reflections_quality=high --frames 30)
render(ssr-floor ssr-high-30b --graphics-set reflections_quality=high --frames 30)
require_same(ssr-plain ssr-off "reflections_quality off")
require_same(ssr-high-30 ssr-high-30b "screen reflections with --fixed-step")
# Under the red pillar, the glossy half now reflects it: redder.
region_mean(ssr-off "0.32,0.45,0.1,0.25" before)
region_mean(ssr-high "0.32,0.45,0.1,0.25" after)
list(GET before 0 r0)
list(GET after 0 r1)
# math() takes integers only: compare the whole parts.
string(REGEX REPLACE "\\..*" "" r0i "${r0}")
string(REGEX REPLACE "\\..*" "" r1i "${r1}")
math(EXPR gain "${r1i} - ${r0i}")
if(gain LESS 10)
    message(FATAL_ERROR "the glossy floor should reflect the red pillar: red ${r0} -> ${r1}")
endif()
# The rough half keeps the probes' reflection.
diff(ssr-off ssr-high "0.56,0.5,0.44,0.5" json)
string(JSON rmse GET "${json}" rmse)
if(rmse GREATER 1.0)
    message(FATAL_ERROR "the rough half changed with screen reflections on (RMSE ${rmse})")
endif()
report(ssr-floor ssr-report "screen reflections" reflections_quality --graphics-set reflections_quality=high)
if(NOT graph MATCHES "screen reflections" OR NOT graph MATCHES "reflection history copy" OR bytes EQUAL 0
   OR NOT effective STREQUAL "high")
    message(FATAL_ERROR "screen reflections on: missing a pass or memory (${bytes} bytes, ${effective}):\n${graph}")
endif()
report(ssr-floor ssr-report-off "screen reflections" reflections_quality --graphics-set reflections_quality=off)
if(graph MATCHES "reflection" OR NOT bytes EQUAL 0)
    message(FATAL_ERROR "screen reflections off still cost a pass or memory (${bytes} bytes):\n${graph}")
endif()
# A wall facing the camera reflects what's behind it, which isn't on screen: the probes'.
render(reflection-rooms rooms-off)
render(reflection-rooms rooms-high --graphics-set reflections_quality=high)
diff(rooms-off rooms-high "0,0.12,0.3,0.4" json)
string(JSON rmse GET "${json}" rmse)
if(rmse GREATER 2.0)
    message(FATAL_ERROR "a wall whose reflection is off screen changed with screen reflections (RMSE ${rmse})")
endif()

# ---- V3 motion blur ----
# Frame 34 is the cube at 48 degrees: its side edges sweep across the screen (face on, at
# frame 30, they only move towards the camera and the flat faces hide the blur).
render(motion-blur blur-taa --anti-aliasing taa --frames 34)
render(motion-blur blur-zero --anti-aliasing taa --frames 34 --graphics-set motion_blur=0)
render(motion-blur blur-one --anti-aliasing taa --frames 34 --graphics-set motion_blur=1)
render(motion-blur blur-one-2 --anti-aliasing taa --frames 34 --graphics-set motion_blur=1)
require_same(blur-taa blur-zero "motion_blur 0")
require_same(blur-one blur-one-2 "motion blur with --fixed-step")
diff(blur-zero blur-one "0.25,0.1,0.5,0.6" json)
string(JSON changed GET "${json}" changed_percent)
if(changed LESS 0.5)
    message(FATAL_ERROR "the spinning cube's edges should smear with motion_blur 1: ${changed}% changed")
endif()
diff(blur-zero blur-one "0,0.85,1,0.15" json)
string(JSON rmse GET "${json}" rmse)
if(rmse GREATER 1.0)
    message(FATAL_ERROR "the still floor changed with motion blur (RMSE ${rmse})")
endif()
report(motion-blur blur-report "motion blur" motion_blur --anti-aliasing taa --frames 34 --graphics-set motion_blur=1)
if(NOT graph MATCHES "motion blur copy" OR bytes EQUAL 0 OR NOT effective STREQUAL "1")
    message(FATAL_ERROR "motion blur on: missing a pass or memory (${bytes} bytes, ${effective}):\n${graph}")
endif()
# Without TAA there are no motion vectors: as 0, with the reason, and no memory.
render(motion-blur blur-fxaa --anti-aliasing fxaa --frames 34)
render(motion-blur blur-fxaa-one --anti-aliasing fxaa --frames 34 --graphics-set motion_blur=1)
require_same(blur-fxaa blur-fxaa-one "motion blur without TAA")
report(motion-blur blur-report-fxaa "motion blur" motion_blur --anti-aliasing fxaa --frames 34 --graphics-set motion_blur=1)
if(graph MATCHES "motion blur" OR NOT bytes EQUAL 0 OR NOT effective STREQUAL "0" OR NOT reason MATCHES "taa")
    message(FATAL_ERROR "motion blur without TAA should fall back with a reason and no memory: '${effective}' "
                        "'${reason}' (${bytes} bytes)")
endif()

# ---- V2 depth of field ----
render(postprocess-dof-none dof-none)
render(postprocess-dof dof-on)
render(postprocess-dof dof-on-2)
render(postprocess-dof dof-off --graphics-set depth_of_field=false)
require_same(dof-none dof-off "depth_of_field false")
require_same(dof-on dof-on-2 "depth of field with --fixed-step")
# The post in focus (10 m) stays sharp; the near (2 m) and far (40 m) ones blur.
diff(dof-none dof-on "0.488,0.14,0.018,0.16" json)
string(JSON rmse GET "${json}" rmse)
if(rmse GREATER 1.0)
    message(FATAL_ERROR "the post in focus changed with depth of field (RMSE ${rmse})")
endif()
diff(dof-none dof-on "0.53,0.3,0.06,0.12" json)
string(JSON far GET "${json}" rmse)
diff(dof-none dof-on "0.26,0.55,0.12,0.45" json)
string(JSON near GET "${json}" rmse)
if(far LESS 2 OR near LESS 1)
    message(FATAL_ERROR "the near and far posts should blur: RMSE near ${near}, far ${far}")
endif()
report(postprocess-dof dof-report "depth of field" depth_of_field)
if(NOT graph MATCHES "depth of field composite" OR bytes EQUAL 0 OR NOT effective STREQUAL "on")
    message(FATAL_ERROR "depth of field on: missing a pass or memory (${bytes} bytes, ${effective}):\n${graph}")
endif()
report(postprocess-dof dof-report-off "depth of field" depth_of_field --graphics-set depth_of_field=false)
if(graph MATCHES "depth of field" OR NOT bytes EQUAL 0)
    message(FATAL_ERROR "depth_of_field false still costs a pass or memory (${bytes} bytes):\n${graph}")
endif()
