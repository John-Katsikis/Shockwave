# Generated by Tests/fixtures/graphics/Tools/material_graph.py; edit that, not this file.
# Glowing cracks: noise scrolling over the surface, sharpened, times a glow colour.
swmatgraph 1
node uv uv
node scale constant 6
node big multiply a=uv b=scale
node speed constant 0.4 0.1
node flow panner uv=big speed=speed
node n noise uv=flow
node cracks power a=n b=4
node glow param glow 6 2 0.3
node hot multiply a=glow b=cracks
node rock constant 0.08 0.07 0.07
node rough constant 0.9
output base_color rock
output emissive hot
output roughness rough

