# Thin slanted geometry: bars at many angles, near-horizontal wires and a fine checker
# floor at a grazing angle. Shows edge stair-stepping, crawling and texture shimmer: the
# anti-aliasing fixture (G01 FXAA, G10 TAA). Cameras: "Main Camera", "Grazing".
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.35 0.42 0.55 1
    ground_color 0.2 0.18 0.15 1
    ambient_intensity 0.6
end

entity "Sun"
  Transform
    rotation -45 30 0
  Light
    type Directional
    color 1 0.95 0.88 1
    intensity 3
end

entity "Floor"
  Transform
    scale 40 1 40
  MeshRenderer
    mesh floor
    texture textures/checker-fine.png
    tint 0.9 0.9 0.9 1
    tiling 0.05 0.05
end

entity "Bar 0"
  Transform
    position -3.3 1.6 -3
    rotation 0 0 -40
    scale 0.03 3 0.03
  MeshRenderer
    mesh cube
    tint 0.95 0.95 0.95 1
end

