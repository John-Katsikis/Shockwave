# Painted terrain (W1b): 128 m of flat ground painted with four layers, one per quadrant
# (red at low X and Z, green at high X, blue at high Z, yellow at both) and all four mixed
# in a disc at the centre, seen from straight above. Camera: "Main Camera".
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.35 0.42 0.55 1
    ground_color 0.2 0.18 0.15 1
    ambient_intensity 0.4
end

entity "Sun"
  Transform
    rotation -70 20 0
  Light
    type Directional
    color 1 1 1 1
    intensity 1.5
end

entity "Painted"
  Transform
    position -64 0 -64
  Terrain
    asset terrain/layers.swterrain
end

entity "Main Camera"
  Transform
    position 0 150 0
    rotation -90 0 0
  Camera
    fov 60
    near_plane 0.1
    primary 1
end
