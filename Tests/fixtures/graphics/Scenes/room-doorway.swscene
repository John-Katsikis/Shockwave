# A closed room with red and green side walls and a doorway: sunlight through the door,
# a warm lamp inside, contact between objects and walls. The indirect-lighting fixture
# (G04 AO, G05 lightmaps, G06 probes). Cameras: "Inside" (looking out), "Outside".
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.35 0.42 0.55 1
    ground_color 0.2 0.18 0.15 1
    ambient_intensity 0.6
end

entity "Sun"
  Transform
    rotation -28 10 0
  Light
    type Directional
    color 1 0.95 0.88 1
    intensity 4
end

entity "Ground"
  Transform
    position 0 -0.2 0
    scale 60 1 60
  MeshRenderer
    mesh floor
    texture grid
    tint 0.55 0.55 0.5 1
end

entity "Room floor"
  Transform
    position 0 -0.1 -4
    scale 8 0.2 8
  MeshRenderer
    mesh cube
    tint 0.82 0.8 0.76 1
end

entity "Ceiling"
  Transform
    position 0 3.1 -4
    scale 8 0.2 8
  MeshRenderer
    mesh cube
    tint 0.82 0.8 0.76 1
end

entity "Left wall (red)"
  Transform
    position -4.1 1.5 -4
    scale 0.2 3.2 8
  MeshRenderer
    mesh cube
    tint 0.75 0.12 0.1 1
end

entity "Right wall (green)"
  Transform
    position 4.1 1.5 -4
    scale 0.2 3.2 8
  MeshRenderer
    mesh cube
    tint 0.12 0.6 0.15 1
end

entity "Back wall"
  Transform
    position 0 1.5 -8.1
    scale 8.4 3.2 0.2
  MeshRenderer
    mesh cube
    tint 0.82 0.8 0.76 1
end

entity "Front wall left"
  Transform
    position -2.4 1.5 0.1
    scale 3.2 3.2 0.2
  MeshRenderer
    mesh cube
    tint 0.82 0.8 0.76 1
end

entity "Front wall right"
  Transform
    position 2.4 1.5 0.1
    scale 3.2 3.2 0.2
  MeshRenderer
    mesh cube
    tint 0.82 0.8 0.76 1
end

entity "Lintel"
  Transform
    position 0 2.65 0.1
    scale 1.6 0.9 0.2
  MeshRenderer
    mesh cube
    tint 0.82 0.8 0.76 1
end

entity "Box"
  Transform
    position -1.6 0.5 -5.5
    rotation 0 20 0
    scale 1 1 1
  MeshRenderer
    mesh cube
    tint 0.8 0.78 0.7 1
end

entity "Ball"
  Transform
    position 1.4 0.5 -3.5
    scale 1 1 1
  MeshRenderer
    mesh sphere
    tint 0.9 0.9 0.9 1
    roughness 0.3
end

entity "Lamp"
  Transform
    position 0 2.6 -5.5
  Light
    type Point
    color 1 0.82 0.6 1
    intensity 6
    range 7
end

entity "Inside"
  Transform
    position 0 1.6 -7.4
    rotation -6 180 0
  Camera
    fov 70
    near_plane 0.05
    primary 1
end

entity "Outside"
  Transform
    position 0 1.7 6
    rotation -4 0 0
  Camera
    fov 60
    near_plane 0.05
    primary 0
end
