# The meadow with wind 0 (Tools/foliage.py).
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.45 0.55 0.7 1
    ground_color 0.2 0.18 0.15 1
    ambient_intensity 0.5
end

entity "Sun"
  Transform
    rotation -40 30 0
  Light
    type Directional
    color 1 0.95 0.85 1
    intensity 2
end

entity "Ground"
  Transform
    scale 140 1 140
  MeshRenderer
    mesh floor
    tint 0.35 0.3 0.22 1
end

entity "Meadow"
  Transform
  Foliage
    asset foliage/meadow-still.swfoliage
end

entity "Main Camera"
  Transform
    position 0 1.7 30
    rotation -12 0 0
  Camera
    fov 60
    near_plane 0.1
    primary 1
end
