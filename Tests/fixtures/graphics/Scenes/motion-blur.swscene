# Motion blur (V3): a cube spinning fast (720 degrees a second) in front of a fixed camera.
# Run with player --fixed-step: frame N is always the same angle (12 degrees a frame).
# With anti_aliasing taa and motion_blur 1 its edges smear along their motion. Camera: "Main Camera".
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.35 0.42 0.55 1
    ground_color 0.2 0.18 0.15 1
    ambient_intensity 0.6
end

entity "Sun"
  Transform
    rotation -45 30 0
  Light
    type Directional
    color 1 0.95 0.88 1
    intensity 3
end

entity "Floor"
  Transform
    scale 30 1 30
  MeshRenderer
    mesh floor
    texture grid
    tint 0.7 0.7 0.7 1
end

entity "Spinning cube"
  Transform
    position 0 1 0
    scale 1.2 1.2 1.2
  MeshRenderer
    mesh cube
    tint 0.85 0.3 0.2 1
  Circuit
    circuit "Circuits/SpinFast.swcircuit"
end

entity "Main Camera"
  Transform
    position 0 1.2 3.5
    rotation -5 0 0
  Camera
    fov 60
    near_plane 0.05
    primary 1
end
