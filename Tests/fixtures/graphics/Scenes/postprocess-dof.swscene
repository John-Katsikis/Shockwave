# Depth of field (V2): textured posts 2, 10 and 40 m from the camera, focused at 10 m by
# postprocess/dof.swpostprocess. The middle post stays sharp; the near and far ones blur.
# postprocess-dof-none is the same scene with an empty profile. Camera: "Main Camera".
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.35 0.42 0.55 1
    ground_color 0.2 0.18 0.15 1
    ambient_intensity 0.6
end

entity "Sun"
  Transform
    rotation -40 30 0
  Light
    type Directional
    color 1 0.95 0.88 1
    intensity 3
end

entity "Floor"
  Transform
    position 0 0 -20
    scale 20 1 60
  MeshRenderer
    mesh floor
    texture grid
    tint 0.7 0.7 0.7 1
end

entity "Post 2 m"
  Transform
    position -0.7 0.5 1
    scale 0.15 1 0.15
  MeshRenderer
    mesh cube
    texture grid
    tint 0.9 0.85 0.8 1
end

entity "Post 10 m"
  Transform
    position 0 2 -7
    scale 0.5 4 0.5
  MeshRenderer
    mesh cube
    texture grid
    tint 0.9 0.85 0.8 1
end

entity "Post 40 m"
  Transform
    position 4 2 -37
    scale 0.5 4 0.5
  MeshRenderer
    mesh cube
    texture grid
    tint 0.9 0.85 0.8 1
end

entity "Postprocess"
  PostProcessVolume
    profile postprocess/dof.swpostprocess
    unbounded true
end

entity "Main Camera"
  Transform
    position 0 1.2 3
    rotation -2 0 0
  Camera
    fov 60
    near_plane 0.1
    primary 1
end
