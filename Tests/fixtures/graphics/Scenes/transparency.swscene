# Two overlapping blended glass panels, an alpha-tested cutout panel and a brightness
# ramp. Ordering, alpha edges and colour preservation (G01, G03 masks, G10 reactive).
# Cameras: "Main Camera", "Side".
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.35 0.42 0.55 1
    ground_color 0.2 0.18 0.15 1
    ambient_intensity 0.6
end

entity "Sun"
  Transform
    rotation -40 25 0
  Light
    type Directional
    color 1 0.95 0.88 1
    intensity 3
end

entity "Floor"
  Transform
    scale 30 1 30
  MeshRenderer
    mesh floor
    texture textures/checker-fine.png
    tint 0.9 0.9 0.9 1
    tiling 0.08 0.08
end

entity "Backdrop"
  Transform
    position 0 1 -2
    scale 6 2 0.2
  MeshRenderer
    mesh cube
    tint 0.2 0.25 0.3 1
end

entity "Panels"
  Transform
    position -0.5 0 0
  ModelRenderer
    model models/panels.glb
end

entity "Ramp"
  Transform
    position 0 2.6 -1.85
    rotation 90 0 0
    scale 4 0.25 1
  MeshRenderer
    mesh plane
    texture textures/ramp.png
    tint 1 1 1 1
end

entity "Main Camera"
  Transform
    position 0.5 1.3 4
    rotation -6 0 0
  Camera
    fov 50
    near_plane 0.05
    primary 1
end

entity "Side"
  Transform
    position 4 1.4 2.5
    rotation -6 55 0
  Camera
    fov 50
    near_plane 0.05
    primary 0
end
