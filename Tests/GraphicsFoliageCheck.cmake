# Foliage (W2a) on the GPU, with the graphics fixtures (Scenes/foliage-meadow*.swscene,
# generated by Tools/foliage.py: 20,000 tufts and pebbles from a low camera):
#   - the report counts the foliage, and the frame's draw calls stay under 200;
#   - foliage_density 0 draws exactly the meadow without its Foliage component;
#   - two --fixed-step runs render the same pixels;
#   - with wind 0, a still camera's frames 30 and 31 are identical without anti-aliasing and
#     differ only by TAA's shimmer at blade edges with it, every instance keeping its history;
#   - wind sways the blades, and under TAA the swaying meadow is about as steady as the still.
# MODE timing (label timing): the frame's foliage submission takes under 2 ms of CPU.
cmake_policy(SET CMP0054 NEW)   # quoted strings in if() are never variables
file(MAKE_DIRECTORY "${TEMP}")
function(render scene name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/${scene}.swscene" --fixed-step --size 320x180 ${ARGN}
        --screenshot "${TEMP}/${name}.png"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "[exit ${result}] ${scene} (${ARGN}) didn't render: ${out}\n${err}")
    endif()
endfunction()
function(diff a b out_var)
    execute_process(COMMAND "${PLAYER}" --image-diff "${TEMP}/${a}.png" "${TEMP}/${b}.png" --tolerance 255
        --json "${TEMP}/diff.json" RESULT_VARIABLE result OUTPUT_QUIET)
    file(READ "${TEMP}/diff.json" json)
    set(${out_var} "${json}" PARENT_SCOPE)
endfunction()
function(report name)
    execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
        --scene "${FIXTURE}/Scenes/foliage-meadow.swscene" --fixed-step --size 320x180 ${ARGN} --graphics-report
        --json "${TEMP}/${name}.json" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "[exit ${result}] --graphics-report (${ARGN}) failed: ${out}\n${err}")
    endif()
    file(READ "${TEMP}/${name}.json" json)
    set(json "${json}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "timing")
    report(timing --frames 30)
    string(JSON submit GET "${json}" foliage submit_ms)
    string(JSON drawn GET "${json}" foliage instances_drawn)
    if(submit GREATER_EQUAL 2)
        message(FATAL_ERROR "submitting ${drawn} foliage instances took ${submit} ms of CPU, not under 2")
    endif()
    message(STATUS "foliage: ${drawn} instances submitted in ${submit} ms")
    return()
endif()

report(report)
string(JSON foliages GET "${json}" foliage foliages)
string(JSON instances GET "${json}" foliage instances)
string(JSON drawn GET "${json}" foliage instances_drawn)
string(JSON calls GET "${json}" drawing calls)
if(NOT foliages EQUAL 1 OR NOT instances EQUAL 20000)
    message(FATAL_ERROR "the report counts ${foliages} foliage with ${instances} instances in range, not 1 and 20000")
endif()
if(drawn LESS 1000)
    message(FATAL_ERROR "only ${drawn} foliage instances were drawn")
endif()
if(calls GREATER_EQUAL 200)
    message(FATAL_ERROR "the meadow took ${calls} draw calls, not under 200")
endif()
report(none --graphics-set foliage_density=0)
string(JSON zeroCalls GET "${json}" foliage calls)
if(NOT zeroCalls EQUAL 0)
    message(FATAL_ERROR "foliage_density 0 still made ${zeroCalls} foliage calls")
endif()

render(foliage-meadow meadow)
render(foliage-meadow meadow-2)
diff(meadow meadow-2 json)
string(JSON rmse GET "${json}" rmse)
if(NOT rmse EQUAL 0)
    message(FATAL_ERROR "two --fixed-step runs of the meadow differ (RMSE ${rmse})")
endif()

render(foliage-meadow density-0 --graphics-set foliage_density=0)
render(foliage-meadow-none no-foliage)
diff(density-0 no-foliage json)
string(JSON rmse GET "${json}" rmse)
if(NOT rmse EQUAL 0)
    message(FATAL_ERROR "foliage_density 0 doesn't match the meadow without foliage (RMSE ${rmse})")
endif()
diff(meadow no-foliage json)
string(JSON changed GET "${json}" changed_percent)
if(changed LESS 5)
    message(FATAL_ERROR "the foliage changed only ${changed}% of the picture")
endif()

foreach(scene foliage-meadow-still foliage-meadow)
    render(${scene} ${scene}-30 --anti-aliasing taa --frames 30)
    render(${scene} ${scene}-31 --anti-aliasing taa --frames 31)
endforeach()
# TAA's sub-pixel jitter keeps thin blades shimmering slightly from frame to frame even
# with nothing moving (without TAA the two frames are identical), so "stable" is: every
# foliage draw keeps its history and the frames differ only at blade edges.
diff(foliage-meadow-still-30 foliage-meadow-still-31 json)
string(JSON stillRmse GET "${json}" rmse)
string(JSON stillChanged GET "${json}" changed_percent)
if(stillRmse GREATER 3 OR stillChanged GREATER 3)
    message(FATAL_ERROR "with wind 0 and TAA, frames 30 and 31 of a still camera differ too much (RMSE ${stillRmse}, ${stillChanged}% changed)")
endif()
render(foliage-meadow-still taa-none-30 --anti-aliasing none --frames 30)
render(foliage-meadow-still taa-none-31 --anti-aliasing none --frames 31)
diff(taa-none-30 taa-none-31 json)
string(JSON rmse GET "${json}" rmse)
if(NOT rmse EQUAL 0)
    message(FATAL_ERROR "with wind 0 and no anti-aliasing, frames 30 and 31 differ (RMSE ${rmse})")
endif()
execute_process(COMMAND "${PLAYER}" --project "${FIXTURE}/Graphics.swproject" --no-user-graphics
    --scene "${FIXTURE}/Scenes/foliage-meadow-still.swscene" --fixed-step --size 320x180 --anti-aliasing taa
    --frames 30 --graphics-report --json "${TEMP}/taa.json" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(READ "${TEMP}/taa.json" json)
string(JSON fresh GET "${json}" temporal new_draws)
string(JSON unkeyed GET "${json}" unkeyed_draws)
if(NOT fresh EQUAL 0 OR NOT unkeyed EQUAL 0)
    message(FATAL_ERROR "under TAA, ${fresh} draws had no history and ${unkeyed} had no key: foliage instances must keep theirs")
endif()
# Wind: the swaying meadow differs from the still one, and its motion vectors keep it about
# as steady under TAA as the still one (RMSE limit 4.5 against the still one's 3).
diff(foliage-meadow-still-30 foliage-meadow-30 json)
string(JSON swayed GET "${json}" changed_percent)
if(swayed LESS 1)
    message(FATAL_ERROR "wind 0.15 changed only ${swayed}% of the picture against wind 0")
endif()
diff(foliage-meadow-30 foliage-meadow-31 json)
string(JSON windyRmse GET "${json}" rmse)
if(windyRmse GREATER 4.5)
    message(FATAL_ERROR "the swaying meadow under TAA changes too much between frames 30 and 31 (RMSE ${windyRmse}, still ${stillRmse}): its motion vectors may be wrong")
endif()
message(STATUS "foliage: ${drawn} of 20000 instances in ${calls} draw calls, deterministic, density 0 is no foliage; TAA frames 30-31 RMSE ${stillRmse} still, ${windyRmse} with wind")
