shockwave_circuit 1
# Turns its entity around the up axis at speed degrees a second. The pulse action (Space,
# or a gamepad's South button) switches between fast and slow.

var speed Float 45

node tick Event.FixedTick

node spin Component.Transform.Set.rotation
  exec tick.then
  in rotation = turned.result

node turned Rotation.Combine
  in first = now.rotation
  in second = step.result

node now Component.Transform.Get.rotation

node step Rotation.AroundY
  in degrees = angle.result

node angle Math.Multiply
  in a = tick.dt
  in b = speed

node pulse Event.ActionPressed
  in action = "pulse"

node toggle Flow.FlipFlop
  exec pulse.then

node fast Set.speed
  exec toggle.a
  in value = 180

node slow Set.speed
  exec toggle.b
  in value = 45

editor
  tick -640 0
  now -640 180
  angle -640 360
  step -180 360
  turned 180 180
  spin 560 0
  pulse -640 600
  toggle -260 600
  fast 120 560
  slow 120 760
end
