shockwave_circuit 1
# Turns its entity around the up axis at speed degrees a second. The pulse action (Space,
# or a gamepad's South button) switches between fast and slow.

var speed Float 45

node tick Event.FixedTick

node spin Transform.RotateByRate
  exec tick.then
  in speed = speed
  in dt = tick.dt

node pulse Event.ActionPressed
  in action = "pulse"

node toggle Flow.FlipFlop
  exec pulse.then

node fast Set.speed
  exec toggle.a
  in value = 180

node slow Set.speed
  exec toggle.b
  in value = 45

editor
  tick -400 0
  spin 0 0
  pulse -400 320
  toggle 0 320
  fast 400 260
  slow 400 520
end
