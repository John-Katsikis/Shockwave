/* The sample's pause menu: a centered panel with a soft shadow and a gradient. */
body {
    font-family: "Noto Sans";
    font-size: 18dp;
    color: #f2f4f8;
    width: 100%;
    height: 100%;
    decorator: radial-gradient(circle, #00000020, #000000a0);   /* dims the game */
}

.menu {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 320dp;
    margin-left: -160dp;
    margin-top: -190dp;
    padding: 20dp 24dp;
    decorator: linear-gradient(180deg, #232a33, #14181e);
    border-top: 3dp #ff8c33;
    box-shadow: #000000b0 0 12dp 32dp 4dp;
}

h1 {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    letter-spacing: 2dp;
    color: #ff8c33;
    margin-bottom: 14dp;
}

h2 {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 1dp;
    color: #aab3c0;
    margin: 18dp 0 6dp;
}

button {
    display: block;
    margin-bottom: 8dp;
    padding: 8dp 14dp;
    font-size: 16dp;
    font-weight: bold;
    background-color: #2c3440;
    border: 2dp transparent;
    cursor: pointer;
}
button:hover { background-color: #36404e; }
/* Where the keyboard or gamepad is. */
button:focus-visible {
    border-color: #ff8c33;
    decorator: linear-gradient(90deg, #ff8c3340, #ff8c3300);
}

.log p { display: block; font-size: 14dp; color: #d5dbe4; margin-bottom: 2dp; }
.log .time { color: #8a94a3; }
.log .empty { color: #8a94a3; }
