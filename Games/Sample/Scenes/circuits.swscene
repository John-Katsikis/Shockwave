# Shockwave scene
shockwave_scene 2

# Circuits (visual scripting, docs/Circuits.md): the crate runs Circuits/Spinner.swcircuit,
# which turns it every tick; press Space (pulse) to switch between fast and slow. Its
# CircuitVars starts it at 90 degrees a second instead of the circuit's 45. The game
# circuit, Circuits/Game.swcircuit, counts the pulses in the log.

entity "Environment"
  Environment
    sky_color 0.32 0.42 0.58 1
end

entity "Floor"
  Transform
    scale 30 1 30
  MeshRenderer
    mesh floor
    texture grid
end

entity "Main Camera"
  Transform
    position 0 2.5 6
    rotation -18 0 0
  Camera
    fov 55
    near_plane 0.1
    primary 1
end

entity "Sun"
  Transform
    position 0 10 0
    rotation -45 -30 0
  Light
    type Directional
    intensity 2.5
end

entity "Spinner"
  Transform
    position 0 0.75 0
    scale 1.5 1.5 1.5
  MeshRenderer
    mesh cube
    texture panel
    tint 1 0.62 0.25 1
  Circuit
    circuit "Circuits/Spinner.swcircuit"
  CircuitVars
    values "speed=90"
end
