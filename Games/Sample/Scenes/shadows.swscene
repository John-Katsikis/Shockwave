# Shockwave scene
shockwave_scene 2

# Shadow showcase: a low evening sun across a row of pillars reaching into the distance
# (View > Shading > Shadow cascades, or player --view cascades, shows the cascades), a
# spot light casting a crate onto the floor, and a point light inside a ring of posts.

entity "Environment"
  Environment
    sky_color 0.45 0.52 0.68 1
    ground_color 0.2 0.17 0.14 1
    ambient_intensity 0.35
    shadow_distance 80
    shadow_cascades 4
end

entity "Floor"
  Transform
    position 0 0 -30
    scale 120 1 120
  MeshRenderer
    mesh floor
    texture grid
    tint 0.9 0.9 0.9 1
end

entity "Main Camera"
  Transform
    position 0 3.5 12
    rotation -12 0 0
  Camera
    fov 60
    near_plane 0.1
    primary 1
end

entity "Sun"
  Transform
    position 0 20 0
    rotation -22 125 0
  Light
    type Directional
    color 1 0.82 0.62 1
    intensity 3
    shadow_softness 0.35
end

