shockwave_scene 2

# Particle stress test: a 4v4 firefight. 8 rifles firing about twelve rounds a
# second, impacts on both lines of cover, smoke columns and grenades. Generated by
# Tools/MakeParticleStress.py; regenerate rather than editing by hand.

entity "Environment"
  Environment
    sky_color 0.32 0.36 0.42 1
    ground_color 0.08 0.07 0.06 1
    ambient_intensity 0.6
    shadow_distance 80
end

entity "Main Camera"
  Transform
    position 0 4 25.0
    rotation -10 0 0
  Camera
    fov 70
    near_plane 0.1
    primary 1
end

entity "Sun"
  Transform
    position 0 30 0
    rotation -40 30 0
  Light
    type Directional
    color 1 0.92 0.8 1
    intensity 2.2
end

entity "Floor"
  Transform
    position 0 -0.25 0
    scale 160 0.5 160
  MeshRenderer
    mesh cube
    texture grid
    tint 0.36 0.34 0.3 1
end

entity "Cover A"
  Transform
    position 0.00 0.60 13.50
    scale 10.6 1.2 0.6
  MeshRenderer
    mesh cube
    texture panel
    tint 0.5 0.48 0.44 1
end

