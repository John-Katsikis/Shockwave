# Shockwave scene
shockwave_scene 2

entity "Environment"
  Environment
    sky_color 0.05 0.06 0.1 1
    ground_color 0.04 0.035 0.03 1
    ambient_intensity 0.5
end

entity "Main Camera"
  Transform
    position 0 3 9
    rotation -12 0 0
  Camera
    fov 60
    near_plane 0.1
    primary 1
end

entity "Moon"
  Transform
    position 0 20 0
    rotation -40 140 0
  Light
    type Directional
    color 0.6 0.7 1 1
    intensity 0.6
end

entity "Floor"
  Transform
    position 0 0 0
    scale 40 1 40
  MeshRenderer
    mesh floor
    texture grid
    tint 0.6 0.6 0.65 1
    visible 1
end

entity "Emitter"
  Transform
    position -5 1 -3
    scale 0.5 0.5 0.5
  MeshRenderer
    mesh cube
    texture panel
    tint 0.3 0.3 0.35 1
    visible 1
end

entity "Laser"
  Transform
    position -5 1 -3
    rotation 0 90 0
  ParticleEffect
    effect "Effects/laser.efkefc"
    playing 1
    loop 1
    speed 1
    scale 0.12
    color 1 1 1 1
end

entity "Emitter 2"
  Transform
    position 5 2 -1
    scale 0.5 0.5 0.5
  MeshRenderer
    mesh cube
    texture panel
    tint 0.3 0.3 0.35 1
    visible 1
end

entity "Green laser"
  Transform
    position 5 2 -1
    rotation 0 -90 0
  ParticleEffect
    effect "Effects/laser.efkefc"
    playing 1
    loop 1
    speed 0.6
    scale 0.1
    color 0.3 1 0.4 1
end

entity "Glow"
  Transform
    position 0 1.5 -2
  Light
    type Point
    color 0.6 0.8 1 1
    intensity 6
    range 8
end
