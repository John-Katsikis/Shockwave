# Shockwave scene
shockwave_scene 2

# Levels of detail: rows of spheres reaching into the distance. Far spheres are drawn
# with simpler versions of the mesh, without a visible change. To see which level each
# one uses: Window > Optimisation > Show levels of detail, or player --lod-colors.

entity "Environment"
  Environment
    sky_color 0.45 0.52 0.68 1
    ground_color 0.2 0.17 0.14 1
    ambient_intensity 0.35
    shadow_distance 80
end

entity "Floor"
  Transform
    position 0 0 -80
    scale 240 1 240
  MeshRenderer
    mesh floor
    texture grid
    tint 0.9 0.9 0.9 1
end

entity "Main Camera"
  Transform
    position 0 4 14
    rotation -8 0 0
  Camera
    fov 60
    near_plane 0.1
    primary 1
end

entity "Sun"
  Transform
    position 0 20 0
    rotation -35 140 0
  Light
    type Directional
    color 1 0.9 0.78 1
    intensity 3
end

entity "Sphere 1-1"
