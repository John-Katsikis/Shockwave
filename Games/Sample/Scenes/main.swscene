# Shockwave scene
shockwave_scene 2
editor_camera 4 2.8 5.5 0.63 -0.33

entity "Environment"
  Environment
    sky_color 0.32 0.42 0.58 1
end

entity "Floor"
  Transform
    position 0 0 0
    rotation 0 0 0
    scale 40 1 40
  MeshRenderer
    mesh floor
    texture grid
    tint 1 1 1 1
    visible 1
end

entity "Crate"
  Transform
    position 0 0.5 0
    rotation 0 20 0
    scale 1 1 1
  MeshRenderer
    mesh cube
    texture panel
    tint 1 0.62 0.25 1
    visible 1
end

entity "Ball"
  Transform
    position 2.2 0.75 0.4
    rotation 0 0 0
    scale 1.5 1.5 1.5
  MeshRenderer
    mesh sphere
    texture checker
    tint 0.35 0.65 1 1
    visible 1
  Bob
    amplitude 0.4
    frequency 0.5
    phase 0
end

entity "Pillar"
  Transform
    position -2.5 1.5 -1.5
    rotation 0 0 0
    scale 1 3 1
  MeshRenderer
    mesh cube
    texture textures/bricks.png
    tint 1 1 1 1
    visible 1
end

entity "Ramp"
  Transform
    position -0.5 0.4 2.6
    rotation 12 -15 0
    scale 3 0.2 1.6
  MeshRenderer
    mesh cube
    texture checker
    tint 0.5 0.9 0.55 1
    visible 1
end

entity "Small crate"
  Transform
    position 0.9 0.3 -1.4
    rotation 0 -35 0
    scale 0.6 0.6 0.6
  MeshRenderer
    mesh cube
    texture panel
    tint 0.95 0.35 0.4 1
    visible 1
  Spin
    axis 0 1 0
    speed 60
end

entity "Moon"
  Transform
    position 1.8 0.4 0
    rotation 0 0 0
    scale 0.5 0.5 0.5
  Parent
    entity "Small crate"
  MeshRenderer
    mesh sphere
    texture checker
    tint 0.9 0.9 1 1
    visible 1
end

entity "Stack"
  Transform
    position 2.6 0 -2.4
    rotation 0 25 0
    scale 1 1 1
end

entity "Lower crate"
  Transform
    position 0 0.4 0
    rotation 0 0 0
    scale 0.8 0.8 0.8
  Parent
    entity "Stack"
  MeshRenderer
    mesh cube
    texture textures/wood.png
    tint 1 1 1 1
    visible 1
end

entity "Upper crate"
  Transform
    position 0.1 1.05 0
    rotation 0 30 0
    scale 0.5 0.5 0.5
  Parent
    entity "Stack"
  MeshRenderer
    mesh cube
    texture textures/wood.png
    tint 1 1 1 1
    visible 1
end

entity "Main Camera"
  Transform
    position 4 2.8 5.5
    rotation -19 36 0
    scale 1 1 1
  Camera
    fov 60
    near_plane 0.1
    primary 1
end

entity "Sun"
  Transform
    position 0 10 0
    rotation -50 35 0
  Light
    type Directional
    color 1 0.95 0.86 1
    intensity 2.6
end

entity "Lamp"
  Transform
    position -1.2 1.4 1.6
  Light
    type Point
    color 1 0.55 0.2 1
    intensity 6
    range 6
end

entity "Spotlight"
  Transform
    position 3.5 3.2 -1.5
    rotation -60 70 0
  Light
    type Spot
    color 0.45 0.7 1 1
    intensity 12
    range 12
    spot_angle 28
    spot_softness 0.3
end
