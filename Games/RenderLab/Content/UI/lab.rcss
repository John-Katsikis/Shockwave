body { font-family: "Noto Sans"; font-size: 14dp; color: #edf4f5; width: 100%; height: 100%; pointer-events: none; }
#readout { position: absolute; left: 18dp; top: 18dp; padding: 12dp 18dp; background-color: #101a20e8; border-left: 2dp #50d0ef; }
h1 { display: block; font-size: 18dp; color: #50d0ef; margin: 0 0 6dp 0; } p { display: block; margin: 3dp 0; }
#controls { position: absolute; bottom: 38dp; left: 18dp; right: 18dp; display: flex; flex-wrap: wrap; gap: 6dp; pointer-events: auto; }
button { background-color: #14232be8; color: #edf4f5; border: 1dp #5c7984; padding: 8dp 14dp; }
button:hover, button:focus-visible { border-color: #50d0ef; background-color: #365767; }
#hint { position: absolute; bottom: 12dp; left: 18dp; font-size: 12dp; color: #c7d6df; }
