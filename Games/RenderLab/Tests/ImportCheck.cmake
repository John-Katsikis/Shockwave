file(MAKE_DIRECTORY "${TEMP}")
file(WRITE "${TEMP}/triangle.obj" "v 0 0 0\nv 2 0 0\nv 0 3 0\nf 1 2 3\n")
execute_process(COMMAND "${IMPORTER}" "${TEMP}/triangle.obj" "${TEMP}/converted/model.gltf" "${TEMP}/report.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Conversion failed: ${out}\n${err}")
endif()
file(READ "${TEMP}/report.json" report)
string(JSON triangles GET "${report}" triangles)
string(JSON vertices GET "${report}" vertices)
string(JSON xmax GET "${report}" max 0)
string(JSON ymax GET "${report}" max 1)
if(NOT triangles EQUAL 1 OR NOT vertices EQUAL 3 OR NOT xmax EQUAL 2 OR NOT ymax EQUAL 3)
    message(FATAL_ERROR "Geometry changed during round trip: ${report}")
endif()
execute_process(COMMAND "${IMPORTER}" "${TEMP}/missing.fbx" "${TEMP}/missing/model.gltf" "${TEMP}/missing.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 1 OR EXISTS "${TEMP}/missing/model.gltf")
    message(FATAL_ERROR "Missing input must fail without publishing output")
endif()
file(REMOVE_RECURSE "${TEMP}")
