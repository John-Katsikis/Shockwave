{
  "format": 1,
  "name": "the Settings page: a volume, the language and a display change kept",
  "timeout": 120,
  "steps": [
    {"assert_level": "menu"},
    {"click": "settings"},
    {"assert_value": "flow.page", "equals": "settings"},
    {"assert_value": "flow.settings_tab", "equals": "display"},
    {"click": "tab-audio"},
    {"assert_value": "flow.settings_tab", "equals": "audio"},
    {"click": "prev-music_volume"},
    {"click": "prev-music_volume"},
    {"assert_value": "flow.settings_changed", "equals": "true"},
    {"click": "apply_settings"},
    {"assert_value": "flow.message", "equals": "Settings saved"},
    {"assert_value": "flow.settings_changed", "equals": "false"},
    {"click": "tab-language"},
    {"click": "next-language"},
    {"click": "apply_settings"},
    {"assert_value": "flow.message", "equals": "Paramètres enregistrés"},
    {"click": "tab-display"},
    {"click": "next-window_mode"},
    {"click": "apply_settings"},
    {"assert_value": "flow.display_pending", "equals": "true"},
    {"click": "keep_display"},
    {"assert_value": "flow.display_pending", "equals": "false"},
    {"click": "settings_back"},
    {"assert_value": "flow.page", "equals": "main"},
    {"click": "new_game"},
    {"wait_phase": "succeeded", "timeout": 30},
    {"wait_value": "game.demo_objective_id", "equals": "training.line"},
    {"assert_value": "game.demo_objective_caption", "equals": "OBJECTIF 0 / 4"},
    {"quit": true}
  ]
}
