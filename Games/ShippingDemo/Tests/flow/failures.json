{
  "format": 1,
  "name": "injected failures (section 25 step 11): a full disk, a cancelled change, a missing and a corrupt level; the last save carries on",
  "timeout": 180,
  "steps": [
    {"assert_level": "menu"},
    {"click": "new_game"},
    {"wait_phase": "succeeded", "timeout": 30},
    {"assert_level": "training"},
    {"save": "acceptance"},
    {"disk_full": true},
    {"save": "acceptance", "expect": "WriteFailed"},
    {"disk_full": false},
    {"travel": "menu"},
    {"wait_phase": "awaiting_boundary", "timeout": 30},
    {"cancel": "travel"},
    {"wait_phase": "cancelled", "expect": "Cancelled"},
    {"assert_level": "training"},
    {"travel": "factory"},
    {"wait_phase": "failed", "expect": "LoadFailed", "timeout": 30},
    {"assert_value": "flow.error_code", "equals": "LoadFailed"},
    {"click": "main_menu"},
    {"wait_phase": "succeeded", "timeout": 30},
    {"assert_level": "menu"},
    {"wait_value": "flow.can_continue", "equals": "true"},
    {"click": "continue"},
    {"wait_phase": "succeeded", "timeout": 30},
    {"assert_level": "training"},
    {"travel": "ending"},
    {"wait_phase": "failed", "expect": "LoadFailed", "timeout": 30},
    {"assert_value": "flow.error_code", "equals": "LoadFailed"},
    {"click": "main_menu"},
    {"wait_phase": "succeeded", "timeout": 30},
    {"assert_level": "menu"},
    {"quit": true}
  ]
}
