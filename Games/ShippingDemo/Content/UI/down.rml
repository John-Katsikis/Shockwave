<rml><head><title>Down</title><link type="text/rcss" href="demo.rcss"/></head>
<body class="screen" data-model="game">
  <div class="dialog">
    <h1>{{text.down.title}}</h1>
    <p>{{text.down.text}}</p>
    <button id="retry_checkpoint" onclick="retry_checkpoint" autofocus>{{text.down.retry_checkpoint}}</button>
    <p class="reason" data-if="!demo_can_retry_checkpoint">{{text.down.no_checkpoint}} {{demo_retry_reason}}</p>
    <button id="retry_level" onclick="retry_level">{{text.down.retry_level}}</button>
    <button id="down_menu" onclick="down_menu">{{text.down.menu}}</button>
  </div>
</body></rml>
