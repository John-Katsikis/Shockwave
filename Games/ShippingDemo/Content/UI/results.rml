<rml><head><title>Results</title><link type="text/rcss" href="demo.rcss"/></head>
<body class="screen" data-model="game">
  <div class="dialog">
    <h1>{{text.results.title}}</h1>
    <div class="stats">
      <div>{{demo_time_text}}</div>
      <div>{{demo_kills_text}}</div>
      <div>{{demo_shots_text}}</div>
    </div>
    <button id="results_continue" onclick="results_continue" autofocus>{{text.results.continue}}</button>
    <p class="reason">{{demo_message}}</p>
  </div>
</body></rml>
