<rml><head><title>Results</title><link type="text/rcss" href="demo.rcss"/></head>
<body class="screen" data-model="game">
  <div class="dialog">
    <h1>Factory secured</h1>
    <div class="stats">
      <div>Time <span>{{demo_time}}</span></div>
      <div>Sentries and guards taken out <span>{{demo_kills}}</span></div>
      <div>Shots fired <span>{{demo_shots}}</span>, accuracy <span>{{demo_accuracy}}</span></div>
    </div>
    <button id="results_continue" onclick="results_continue" autofocus>Continue</button>
    <p class="reason">{{demo_message}}</p>
  </div>
</body></rml>
