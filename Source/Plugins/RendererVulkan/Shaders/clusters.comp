#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// Clustered local lighting (G11, RendererClusters.cpp, Renderer/Clusters.h): one thread per
// cluster lists the point and spot lights whose sphere touches the cluster's box, testing
// them in light table order, so a pixel adds them up in the same order as the loop over every
// light. More than kClusterCapacity sets the overflow bit, and those pixels test every local
// light: a light is never dropped.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "frame.glsl"
#include "clusters.glsl"

layout(buffer_reference, scalar) buffer ClusterCounters {
    uint candidates;   // over all clusters, before capping
    uint mostCandidates;   // in one cluster
    uint overflowed;   // clusters
    uint clusters;
};

// Must match ClusterPushConstants in RendererClusters.cpp.
layout(push_constant, scalar) uniform PushConstants {
    FrameBuffer frame;
    ClusterLists lists;
    ClusterCounters counters;
} pc;

// Renderer/Clusters.h's clusterSliceStart.
float sliceStart(FrameBuffer frame, uint s) {
    return frame.clusterNear * pow(frame.clusterFar / frame.clusterNear, float(s) / float(frame.clusterSlices));
}

void main() {
    FrameBuffer frame = pc.frame;
    uint index = gl_GlobalInvocationID.x;
    uint tiles = frame.clusterTilesX * frame.clusterTilesY;
    if (index >= tiles * frame.clusterSlices) return;
    uvec3 c = uvec3(index % frame.clusterTilesX, (index / frame.clusterTilesX) % frame.clusterTilesY, index / tiles);

    // The cluster's view-space box (Renderer/Clusters.h clusterBounds): its tile grown by a
    // pixel each way, between its slice's distances grown by 0.1%.
    vec2 lo = vec2(c.xy) * float(frame.clusterTile) - 1.0;
    vec2 hi = vec2(c.xy + 1u) * float(frame.clusterTile) + 1.0;
    float z0 = sliceStart(frame, c.z) * 0.999, z1 = sliceStart(frame, c.z + 1u) * 1.001;
    vec3 boxLo = vec3(1e30), boxHi = vec3(-1e30);
    for (int corner = 0; corner < 4; ++corner) {
        vec2 pixel = vec2((corner & 1) != 0 ? hi.x : lo.x, (corner & 2) != 0 ? hi.y : lo.y);
        vec2 ndc = vec2(2.0 * pixel.x / frame.renderSize.x - 1.0, 1.0 - 2.0 * pixel.y / frame.renderSize.y);
        vec4 h = frame.inverseProjection * vec4(ndc, 1.0, 1.0);
        vec3 p = h.xyz / h.w;
        vec3 a = p * (z0 / -p.z), b = p * (z1 / -p.z);
        boxLo = min(boxLo, min(a, b));
        boxHi = max(boxHi, max(a, b));
    }

    uint start = index * kClusterWords;
    uint count = 0u, word = 0u;
    for (uint i = frame.directionalCount; i < frame.lightCount; ++i) {
        vec3 centre = (frame.view * vec4(frame.lights[i].position, 1.0)).xyz;
        vec3 d = centre - clamp(centre, boxLo, boxHi);
        float r = frame.lights[i].range * 1.001 + 1e-4;
        if (dot(d, d) > r * r) continue;
        if (count < kClusterCapacity) {
            word |= i << ((count & 3u) * 8u);
            if ((count & 3u) == 3u) {
                pc.lists.words[start + 1u + (count >> 2)] = word;
                word = 0u;
            }
        }
        ++count;
    }
    if (count < kClusterCapacity && (count & 3u) != 0u) pc.lists.words[start + 1u + (count >> 2)] = word;
    pc.lists.words[start] = count > kClusterCapacity ? (kClusterCapacity | kClusterOverflow) : count;
    atomicAdd(pc.counters.candidates, count);
    atomicMax(pc.counters.mostCandidates, count);
    if (count > kClusterCapacity) atomicAdd(pc.counters.overflowed, 1u);
}
